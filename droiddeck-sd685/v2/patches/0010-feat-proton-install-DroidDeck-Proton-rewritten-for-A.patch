new file mode 100644
index 0000000..22b6c4b
--- /dev/null
+++ b/tools/armv80/tests/wintest.c
@@ -0,0 +1,42 @@
+/* A Windows x86 program for the emulated-ARMv8.0 Proton test: x86 atomics translated by FEX,
+ * threads, SSE floating point and a little memory traffic. Prints one deterministic line per
+ * check and "OK" at the end. */
+#include <windows.h>
+#include <stdio.h>
+#include <math.h>
+
+static volatile LONG counter;
+static volatile LONG64 counter64;
+static CRITICAL_SECTION cs;
+static long guarded;
+
+static DWORD WINAPI worker(LPVOID arg) {
+    (void)arg;
+    for (int i = 0; i < 50000; i++) {
+        InterlockedIncrement(&counter);
+        InterlockedAdd64(&counter64, 3);
+        EnterCriticalSection(&cs); guarded++; LeaveCriticalSection(&cs);
+    }
+    return 0;
+}
+
+int main(void) {
+    SYSTEM_INFO si; GetNativeSystemInfo(&si);
+    printf("arch %u cpus %lu\n", si.wProcessorArchitecture, si.dwNumberOfProcessors);
+    LONG v = 5;
+    printf("cmpxchg %ld %ld\n", InterlockedCompareExchange(&v, 9, 5), v);
+    printf("xchg %ld %ld\n", InterlockedExchange(&v, 42), v);
+    double acc = 0; for (int i = 1; i <= 100000; i++) acc += sqrt((double)i) / i;
+    printf("fp %.6f\n", acc);
+    InitializeCriticalSection(&cs);
+    HANDLE t[4];
+    for (int i = 0; i < 4; i++) t[i] = CreateThread(NULL, 0, worker, NULL, 0, NULL);
+    WaitForMultipleObjects(4, t, TRUE, INFINITE);
+    printf("threads %ld %lld %ld\n", counter, (long long)counter64, guarded);
+    char *buf = HeapAlloc(GetProcessHeap(), 0, 1 << 20); long sum = 0;
+    for (int i = 0; i < (1 << 20); i++) buf[i] = (char)i;
+    for (int i = 0; i < (1 << 20); i++) sum += buf[i];
+    printf("heap %ld\n", sum);
+    printf("%s\n", (counter == 200000 && counter64 == 600000 && guarded == 200000) ? "OK" : "FAIL");
+    return 0;
+}
diff --git a/tools/linuxfs/overlay/usr/local/bin/droiddeck-proton-armv80 b/tools/linuxfs/overlay/usr/local/bin/droiddeck-proton-armv80
new file mode 100755
index 0000000..664d40f
--- /dev/null
+++ b/tools/linuxfs/overlay/usr/local/bin/droiddeck-proton-armv80
@@ -0,0 +1,167 @@
+#!/usr/bin/python3
+"""Installs DroidDeck-Proton for CPUs without ARMv8.1 atomics (Cortex-A53/A73: Snapdragon 6xx, 835).
+
+Every arm64 Proton build uses LSE atomics with no runtime check, so it stops with SIGILL on such a
+CPU. This takes the pinned upstream release, verifies it, and applies a patch made by DroidDeck's
+tools/armv80/rewrite_tree.py: each LSE instruction branches to an equivalent load/store-exclusive
+sequence. Every patched file is checked against the sha256 of the original and of the result.
+
+    droiddeck-proton-armv80 <steam root>          install when missing; prints the tool name
+    droiddeck-proton-armv80 <steam root> --name   print the tool name if it is installed
+"""
+import hashlib
+import os
+import shutil
+import struct
+import subprocess
+import sys
+import zlib
+
+RELEASE = "DroidDeck-Proton 11-12.8"
+URL = ("https://github.com/Droid-Deck/DroidDeck-Proton/releases/download/"
+       "DroidDeck-Proton-11-12.8/DroidDeck-Proton-11-12.8-aarch64.tar.gz")
+SHA256 = "f100aa06d7373a6c4b53a8ec4f019fb69be3bf0200e2e6916326cb1c3a94e3ea"
+PATCH = os.environ.get("DROIDDECK_ARMV80_PATCH", "/usr/local/share/droiddeck-armv80/DroidDeck-Proton-11-12.8.lse80")
+DIR = "ARMv8.0-DroidDeck-Proton-11-12.8"
+TOOL = "droiddeck-proton-11-12.8-armv80"
+DISPLAY = "DroidDeck-Proton 11-12.8 (ARMv8.0)"
+MARK = ".droiddeck-armv80"
+MAGIC = b"LSE80PATCH1\n"
+NEED_BYTES = 3 * 1024 ** 3
+
+
+def log(message):
+    print("droiddeck-proton-armv80: " + message, flush=True)
+
+
+def sha256_file(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(4 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def read_patch(path):
+    data = open(path, "rb").read()
+    if not data.startswith(MAGIC):
+        raise SystemExit("droiddeck-proton-armv80: %s is not a patch" % path)
+    count = struct.unpack_from("<I", data, len(MAGIC))[0]
+    body = zlib.decompress(data[len(MAGIC) + 4:])
+    pos, entries = 0, []
+    for _ in range(count):
+        n = struct.unpack_from("<H", body, pos)[0]
+        pos += 2
+        name = body[pos:pos + n].decode()
+        pos += n
+        before, after = body[pos:pos + 32], body[pos + 32:pos + 64]
+        pos += 64
+        size, nruns = struct.unpack_from("<QI", body, pos)
+        pos += 12
+        runs = []
+        for _ in range(nruns):
+            off, length = struct.unpack_from("<QI", body, pos)
+            pos += 12
+            runs.append((off, body[pos:pos + length]))
+            pos += length
+        entries.append((name, before, after, size, runs))
+    return entries
+
+
+def apply(tree, entries):
+    for name, before, after, size, runs in entries:
+        path = os.path.join(tree, name)
+        data = bytearray(open(path, "rb").read())
+        if hashlib.sha256(data).digest() != before:
+            raise SystemExit("droiddeck-proton-armv80: %s is not the file the patch was made for" % name)
+        if len(data) < size:
+            data += b"\0" * (size - len(data))
+        del data[size:]
+        for off, chunk in runs:
+            data[off:off + len(chunk)] = chunk
+        if hashlib.sha256(data).digest() != after:
+            raise SystemExit("droiddeck-proton-armv80: %s did not patch cleanly" % name)
+        mode = os.stat(path).st_mode
+        tmp = path + ".armv80"
+        with open(tmp, "wb") as f:
+            f.write(data)
+        os.chmod(tmp, mode)
+        os.replace(tmp, path)
+
+
+def rename_tool(tree):
+    path = os.path.join(tree, "compatibilitytool.vdf")
+    text = open(path, encoding="utf-8").read()
+    text = text.replace('"DroidDeck-Proton-11-12.8"', '"%s"' % TOOL, 1)
+    text = text.replace('"display_name" "%s"' % RELEASE, '"display_name" "%s"' % DISPLAY, 1)
+    if TOOL not in text:
+        raise SystemExit("droiddeck-proton-armv80: unexpected compatibilitytool.vdf")
+    open(path, "w", encoding="utf-8").write(text)
+
+
+def main():
+    if len(sys.argv) < 2:
+        raise SystemExit(__doc__)
+    root = sys.argv[1]
+    tools = os.path.join(root, "compatibilitytools.d")
+    final = os.path.join(tools, DIR)
+    want = sha256_file(PATCH) if os.path.isfile(PATCH) else None
+    try:
+        done = open(os.path.join(final, MARK)).read().strip() == want and want is not None
+    except OSError:
+        done = False
+    if done or "--name" in sys.argv[2:]:
+        if done:
+            print(TOOL)
+        return
+    if want is None:
+        raise SystemExit("droiddeck-proton-armv80: no patch at %s" % PATCH)
+    os.makedirs(tools, exist_ok=True)
+    if shutil.disk_usage(tools).free < NEED_BYTES:
+        raise SystemExit("droiddeck-proton-armv80: needs about 3 GB free")
+    staging = os.path.join(tools, ".droiddeck-armv80")
+    os.makedirs(staging, exist_ok=True)
+    tree = os.path.join(staging, "tree")
+    shutil.rmtree(tree, ignore_errors=True)
+    entries = read_patch(PATCH)
+    base = os.path.join(tools, RELEASE)
+    if os.path.isfile(os.path.join(base, "toolmanifest.vdf")) and \
+            all(os.path.isfile(os.path.join(base, e[0])) for e in entries):
+        log("using the installed %s as the base" % RELEASE)
+        shutil.copytree(base, tree, symlinks=True)
+    else:
+        tarball = os.path.join(staging, "DroidDeck-Proton-11-12.8-aarch64.tar.gz")
+        if not (os.path.isfile(tarball) and sha256_file(tarball) == SHA256):
+            log("downloading %s (626 MB, once)" % RELEASE)
+            rc = subprocess.call(["curl", "-fL", "--retry", "5", "--retry-delay", "3", "-C", "-",
+                                  "-A", "droiddeck-proton-armv80", "-o", tarball, URL])
+            if rc != 0:
+                raise SystemExit("droiddeck-proton-armv80: download failed (curl %d)" % rc)
+            if sha256_file(tarball) != SHA256:
+                os.unlink(tarball)
+                raise SystemExit("droiddeck-proton-armv80: the download did not match its checksum")
+        log("unpacking (a few minutes)")
+        unpacked = os.path.join(staging, "unpacked")
+        shutil.rmtree(unpacked, ignore_errors=True)
+        os.makedirs(unpacked)
+        if subprocess.call(["tar", "-xf", tarball, "-C", unpacked]) != 0:
+            raise SystemExit("droiddeck-proton-armv80: tar failed")
+        os.rename(os.path.join(unpacked, RELEASE), tree)
+        shutil.rmtree(unpacked, ignore_errors=True)
+        os.unlink(tarball)
+    log("rewriting %d files for this CPU" % len(entries))
+    apply(tree, entries)
+    rename_tool(tree)
+    with open(os.path.join(tree, MARK), "w") as f:
+        f.write(want + "\n")
+    shutil.rmtree(final, ignore_errors=True)
+    os.rename(tree, final)
+    shutil.rmtree(staging, ignore_errors=True)
+    log("installed %s" % DISPLAY)
+    if shutil.which("steam-compatibility"):
+        subprocess.call(["steam-compatibility", root])
+    print(TOOL)
+
+
+if __name__ == "__main__":
+    main()
