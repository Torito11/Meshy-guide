diff --git a/tools/tests/test_armv80_rewrite.py b/tools/tests/test_armv80_rewrite.py
new file mode 100644
index 0000000..da9bb16
--- /dev/null
+++ b/tools/tests/test_armv80_rewrite.py
@@ -0,0 +1,184 @@
+"""tools/armv80: LSE decoding, stub semantics (by encoding), ELF/PE rewriting, the patch format and the
+on-device installer. Execution on an ARMv8.0 CPU is covered by tools/armv80/tests (QEMU)."""
+import hashlib
+import os
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+TOOLS = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(TOOLS / 'armv80'))
+import a64  # noqa: E402
+import rewrite  # noqa: E402
+import stubs  # noqa: E402
+from lse_decode import decode  # noqa: E402
+
+INSTALLER = TOOLS / 'linuxfs/overlay/usr/local/bin/droiddeck-proton-armv80'
+LDADDAL_X = 0xF8E00000 | (1 << 16) | (0 << 5) | 2      # ldaddal x1, x2, [x0]
+CASAL_W = 0x88E0FC00 | (3 << 16) | (4 << 5) | 5       # casal w3, w5, [x4]
+LDAPR_X = 0xF8BFC000 | (6 << 5) | 7                    # ldapr x7, [x6]
+NOP = 0xD503201F
+
+
+def elf(words, note=True, exe=False):
+    """A minimal AArch64 ELF64: one R+X PT_LOAD at 0 holding .text, optional PT_NOTE / PT_PHDR."""
+    text = b"".join(struct.pack("<I", w) for w in words)
+    phnum = 1 + note + exe
+    text_off = 64 + 56 * phnum
+    shstr = b"\0.text\0.shstrtab\0"
+    sh_off = text_off + len(text) + len(shstr)
+    sh_off += (-sh_off) % 8
+    out = bytearray(sh_off + 64 * 3)
+    struct.pack_into("<4sBBBB8xHHIQQQIHHHHHH", out, 0, b"\x7fELF", 2, 1, 1, 0, 3 if exe else 3, 183, 1, 0,
+                     64, sh_off, 0, 64, 56, phnum, 64, 3, 2)
+    phs = []
+    if exe:
+        phs.append((6, 4, 64, 64, 64, 56 * phnum, 56 * phnum, 8))
+    phs.append((1, 5, 0, 0, 0, text_off + len(text), text_off + len(text), 0x10000))
+    if note:
+        phs.append((4, 4, text_off, text_off, text_off, 0, 0, 4))
+    for i, ph in enumerate(phs):
+        struct.pack_into("<IIQQQQQQ", out, 64 + 56 * i, *ph)
+    out[text_off:text_off + len(text)] = text
+    out[text_off + len(text):text_off + len(text) + len(shstr)] = shstr
+    struct.pack_into("<IIQQQQIIQQ", out, sh_off + 64, 1, 1, 6, text_off, text_off, len(text), 0, 0, 4, 0)
+    struct.pack_into("<IIQQQQIIQQ", out, sh_off + 128, 7, 3, 0, 0, text_off + len(text), len(shstr), 0, 0, 1, 0)
+    return bytes(out)
+
+
+def phdrs(data):
+    phoff = struct.unpack_from("<Q", data, 0x20)[0]
+    phnum = struct.unpack_from("<H", data, 0x38)[0]
+    return [struct.unpack_from("<IIQQQQQQ", data, phoff + 56 * i) for i in range(phnum)]
+
+
+def text_words(data):
+    shoff = struct.unpack_from("<Q", data, 0x28)[0]
+    _, _, _, addr, off, size = struct.unpack_from("<IIQQQQ", data, shoff + 64)
+    return addr, [struct.unpack_from("<I", data, off + 4 * i)[0] for i in range(size // 4)]
+
+
+class DecodeTest(unittest.TestCase):
+    def test_forms(self):
+        self.assertEqual(decode(LDADDAL_X)["kind"], "ld")
+        self.assertEqual(decode(LDADDAL_X)["op"], "add")
+        self.assertEqual((decode(LDADDAL_X)["acq"], decode(LDADDAL_X)["rel"]), (1, 1))
+        self.assertEqual(decode(CASAL_W)["kind"], "cas")
+        self.assertEqual(decode(LDAPR_X)["kind"], "ldapr")
+        self.assertIsNone(decode(NOP))
+        self.assertIsNone(decode(a64.ldxr(3, 1, 1, 2)))     # ARMv8.0 exclusives are left alone
+        self.assertIsNone(decode(0x08217C00))               # CASP with odd registers is unallocated
+
+    def test_stub_shape(self):
+        info = decode(LDADDAL_X)
+        code = stubs.build(info, 0x1000, 0x20000)
+        words = [struct.unpack_from("<I", code, i)[0] for i in range(0, len(code), 4)]
+        self.assertTrue(all(decode(w) is None for w in words))
+        self.assertTrue(any((w & ~0x1F) == (a64.ldxr(3, 1, 0, 0) & ~0x1F) for w in words))      # ldaxr x?, [x0]
+        self.assertTrue(any((w & ~0x1F001F) == (a64.stxr(3, 1, 0, 0, 0) & ~0x1F001F) for w in words))  # stlxr w?, x?, [x0]
+        self.assertEqual(words[-1], a64.b(0x1004 - (0x20000 + len(code) - 4)))
+
+
+class ElfTest(unittest.TestCase):
+    def check(self, note, exe):
+        data = elf([NOP, LDADDAL_X, CASAL_W, LDAPR_X, NOP], note=note, exe=exe)
+        out, n = rewrite.rewrite(data)
+        self.assertEqual(n, 3)
+        addr, words = text_words(out)
+        self.assertEqual(words[0], NOP)
+        self.assertEqual(words[3], a64.ldar(3, 7, 6))
+        self.assertTrue(all(decode(w) is None for w in words))
+        loads = [p for p in phdrs(out) if p[0] == 1]
+        self.assertEqual(len(loads), 2)
+        stub_seg = loads[1]
+        self.assertEqual(stub_seg[1], 5)
+        self.assertEqual(stub_seg[2] % 0x10000, stub_seg[3] % 0x10000)
+        # the patched sites branch into the new segment
+        for i in (1, 2):
+            w = words[i]
+            self.assertEqual(w >> 26, 0x05)
+            target = addr + 4 * i + (((w & 0x3FFFFFF) ^ 0x2000000) - 0x2000000) * 4
+            self.assertTrue(stub_seg[3] <= target < stub_seg[3] + stub_seg[5])
+        if exe:
+            phdr = [p for p in phdrs(out) if p[0] == 6][0]
+            self.assertEqual(phdr[2], struct.unpack_from("<Q", out, 0x20)[0])
+            self.assertTrue(stub_seg[3] <= phdr[3] < stub_seg[3] + stub_seg[5])
+        self.assertIsNone(rewrite.rewrite(out)[0])
+
+    def test_with_note(self):
+        self.check(note=True, exe=False)
+
+    def test_without_note_moves_the_program_headers(self):
+        self.check(note=False, exe=False)
+
+    def test_executable_keeps_pt_phdr_consistent(self):
+        self.check(note=False, exe=True)
+
+    def test_clean_file_is_left_alone(self):
+        self.assertIsNone(rewrite.rewrite(elf([NOP, NOP]))[0])
+
+
+class PatchAndInstallerTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def proton(self, where):
+        tree = where / "DroidDeck-Proton 11-12.8"
+        (tree / "files/lib/wine/aarch64-unix").mkdir(parents=True)
+        (tree / "files/lib/wine/aarch64-unix/ntdll.so").write_bytes(elf([LDADDAL_X, NOP, CASAL_W]))
+        (tree / "files/lib/wine/aarch64-unix/clean.so").write_bytes(elf([NOP]))
+        (tree / "toolmanifest.vdf").write_text('"manifest"\n{\n  "commandline" "/proton %verb%"\n}\n')
+        (tree / "compatibilitytool.vdf").write_text(
+            '"compatibilitytools"\n{\n  "compat_tools"\n  {\n    "DroidDeck-Proton-11-12.8" // Internal name\n'
+            '    {\n      "install_path" "."\n      "display_name" "DroidDeck-Proton 11-12.8"\n'
+            '      "from_oslist"  "windows"\n      "to_oslist"    "linux"\n    }\n  }\n}\n')
+        return tree
+
+    def test_patch_applies_to_an_installed_base_and_marks_the_tool(self):
+        tree = self.proton(self.root / "src")
+        patch = self.root / "p.lse80"
+        subprocess.run([sys.executable, str(TOOLS / "armv80/rewrite_tree.py"), str(tree), str(self.root / "out"), str(patch)],
+                       check=True, capture_output=True)
+        steam = self.root / "steam"
+        shutil.copytree(tree, steam / "compatibilitytools.d" / tree.name)
+        env = dict(os.environ, DROIDDECK_ARMV80_PATCH=str(patch), PATH="/usr/bin:/bin")
+        result = subprocess.run([sys.executable, str(INSTALLER), str(steam)], env=env, capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout.strip().splitlines()[-1], "droiddeck-proton-11-12.8-armv80")
+        final = steam / "compatibilitytools.d/ARMv8.0-DroidDeck-Proton-11-12.8"
+        self.assertEqual((final / "files/lib/wine/aarch64-unix/ntdll.so").read_bytes(),
+                         (self.root / "out/files/lib/wine/aarch64-unix/ntdll.so").read_bytes())
+        self.assertIn('"droiddeck-proton-11-12.8-armv80"', (final / "compatibilitytool.vdf").read_text())
+        self.assertIn('"display_name" "DroidDeck-Proton 11-12.8 (ARMv8.0)"', (final / "compatibilitytool.vdf").read_text())
+        self.assertEqual((final / ".droiddeck-armv80").read_text().strip(), hashlib.sha256(patch.read_bytes()).hexdigest())
+        # the base install is not modified and a second run does nothing
+        self.assertEqual((steam / "compatibilitytools.d" / tree.name / "files/lib/wine/aarch64-unix/ntdll.so").read_bytes(),
+                         (tree / "files/lib/wine/aarch64-unix/ntdll.so").read_bytes())
+        again = subprocess.run([sys.executable, str(INSTALLER), str(steam)], env=env, capture_output=True, text=True)
+        self.assertEqual(again.stdout.strip(), "droiddeck-proton-11-12.8-armv80")
+
+    def test_a_different_base_is_refused(self):
+        tree = self.proton(self.root / "src")
+        patch = self.root / "p.lse80"
+        subprocess.run([sys.executable, str(TOOLS / "armv80/rewrite_tree.py"), str(tree), str(self.root / "out"), str(patch)],
+                       check=True, capture_output=True)
+        steam = self.root / "steam"
+        other = shutil.copytree(tree, steam / "compatibilitytools.d" / tree.name)
+        (other / "files/lib/wine/aarch64-unix/ntdll.so").write_bytes(elf([CASAL_W, NOP, LDADDAL_X]))
+        env = dict(os.environ, DROIDDECK_ARMV80_PATCH=str(patch), PATH="/usr/bin:/bin")
+        result = subprocess.run([sys.executable, str(INSTALLER), str(steam)], env=env, capture_output=True, text=True)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("is not the file the patch was made for", result.stderr)
+        self.assertFalse((steam / "compatibilitytools.d/ARMv8.0-DroidDeck-Proton-11-12.8").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
