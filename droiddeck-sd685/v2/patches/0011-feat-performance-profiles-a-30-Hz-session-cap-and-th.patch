+    private fun applyDisplayRate(target: Int) {
+        if (target <= 0) return
+        @Suppress("DEPRECATION") val display = windowManager.defaultDisplay ?: return
+        val current = display.mode
+        val pick = display.supportedModes
+            .filter { it.physicalWidth == current.physicalWidth && it.physicalHeight == current.physicalHeight && it.refreshRate >= target - 0.5f }
+            .minByOrNull { it.refreshRate } ?: return
+        window.attributes = window.attributes.apply { preferredDisplayModeId = pick.modeId }
+        diag("cloud player: display mode ${pick.refreshRate.toInt()} Hz for $target fps")
+    }
+
     private val rehideBars = Runnable { if (window.decorView.hasWindowFocus()) hideBars() }
 
     private fun watchBars() {
