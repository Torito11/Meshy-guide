--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/core/PerformanceProfilesTest.kt
@@ -0,0 +1,94 @@
+package com.droiddeck.launcher.core
+
+import android.app.Application
+import com.droiddeck.launcher.session.SessionPrefs
+import com.droiddeck.launcher.stores.xbox.XboxCloudSettings
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.robolectric.RuntimeEnvironment
+
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner::class)
+@org.robolectric.annotation.Config(sdk = [33], application = Application::class)
+class PerformanceProfilesTest {
+    private val sd685 = (0..3).associateWith<Int, Double?> { 1.9 } + (4..7).associateWith { 2.8 }
+
+    @Test fun theEfficiencyClusterIsTheSlowestCores() {
+        assertEquals("0,1,2,3", CpuCores.littleCores(sd685))
+        assertEquals("0,1,2,3,4,5", CpuCores.littleCores((0..5).associateWith<Int, Double?> { 2.0 } + (6..7).associateWith { 2.2 }))
+        assertEquals("", CpuCores.littleCores((0..7).associateWith { 2.4 }))
+        assertEquals("", CpuCores.littleCores(sd685 + (3 to null)))
+        assertEquals("", CpuCores.littleCores(mapOf(0 to 1.8)))
+    }
+
+    @Test fun everyProfileUsesKnownSafeValues() {
+        for (lowTier in listOf(true, false)) for (id in PerformanceProfiles.all) {
+            val p = PerformanceProfiles.plan(id, lowTier, "0,1,2,3")
+            p.refreshCap?.let { assertTrue("$id refresh $it", it in setOf(0, 30, 60)) }
+            p.fexPreset?.let { assertEquals("$id fex", it, FexPreset.byId(it).id) }
+            p.cloud?.resolution?.let { assertTrue(it in setOf("720p", "1080p")) }
+            p.cloud?.bitrateMbps?.let { assertTrue(it in 0..100) }
+        }
+    }
+
+    @Test fun batterySaverHalvesTheFramesAndStreamsAt720p() {
+        val p = PerformanceProfiles.plan(PerformanceProfiles.BATTERY, lowTier = true, little = "0,1,2,3")
+        assertEquals(30, p.refreshCap)
+        assertEquals("0,1,2,3", p.clientCores)
+        assertEquals(false, p.shaderPrecache)
+        assertEquals(false, p.steamDownloadsInBackground)
+        val cloud = p.cloud!!.applyTo(XboxCloudSettings())
+        assertEquals("720p", cloud.resolution)
+        assertEquals(60, cloud.fpsTarget)
+        assertEquals(8, cloud.bitrateMbps)
+        assertEquals("off", cloud.frameGen)
+    }
+
+    @Test fun performanceGivesTheGameTheFastCoresAndKeepsGamescopeFree() {
+        val low = PerformanceProfiles.plan(PerformanceProfiles.PERFORMANCE, lowTier = true, little = "0,1,2,3")
+        assertEquals(60, low.refreshCap)
+        assertEquals("PERFORMANCE_TSO", low.fexPreset)
+        assertEquals("0,1,2,3", low.clientCores)
+        assertEquals(false, low.pinGamescope)
+        assertEquals(true, low.gameThreadHints)
+        assertEquals(false, low.shaderPrecache)
+        val high = PerformanceProfiles.plan(PerformanceProfiles.PERFORMANCE, lowTier = false, little = "")
+        assertEquals(0, high.refreshCap)
+        assertEquals("", high.clientCores)
+        assertNull(high.shaderPrecache)
+    }
+
+    @Test fun compatibilityKeepsX86MemoryOrderingAndTheWebPlayer() {
+        val p = PerformanceProfiles.plan(PerformanceProfiles.COMPATIBILITY, lowTier = true, little = "0,1,2,3")
+        assertEquals("COMPATIBILITY", p.fexPreset)
+        assertEquals("", p.clientCores)
+        assertEquals("web", p.cloud!!.applyTo(XboxCloudSettings(playerEngine = "native")).playerEngine)
+    }
+
+    @Test fun xboxCloudOnlyChangesTheStream() {
+        val p = PerformanceProfiles.plan(PerformanceProfiles.XBOX_CLOUD, lowTier = true, little = "0,1,2,3")
+        assertNull(p.refreshCap); assertNull(p.fexPreset); assertNull(p.clientCores); assertNull(p.gameThreadHints)
+        val cloud = p.cloud!!.applyTo(XboxCloudSettings(fpsCustomOn = true, fpsCustom = 45))
+        assertEquals(0, cloud.fpsTarget)
+        assertEquals("off", cloud.frameGen)
+        assertTrue(cloud.zeroCopy && cloud.smallBuffer && cloud.fastDecoder)
+    }
+
+    @Test fun aChosenProfileReadsBackUntilASettingChanges() {
+        val app = RuntimeEnvironment.getApplication()
+        for (id in PerformanceProfiles.all) {
+            PerformanceProfiles.apply(app, id)
+            assertEquals(id, PerformanceProfiles.current(app))
+        }
+        PerformanceProfiles.apply(app, PerformanceProfiles.BATTERY)
+        assertEquals(30, SessionPrefs.refreshCap(app))
+        assertEquals("720p", XboxCloudSettings.load(app).resolution)
+        SessionPrefs.setRefreshCap(app, 60)
+        assertEquals(PerformanceProfiles.CUSTOM, PerformanceProfiles.current(app))
+        PerformanceProfiles.apply(app, PerformanceProfiles.XBOX_CLOUD)
+        assertEquals(PerformanceProfiles.XBOX_CLOUD, PerformanceProfiles.current(app))
+        XboxCloudSettings.save(app, XboxCloudSettings.load(app).copy(bitrateMbps = 12))
+        assertEquals(PerformanceProfiles.CUSTOM, PerformanceProfiles.current(app))
+    }
+}
