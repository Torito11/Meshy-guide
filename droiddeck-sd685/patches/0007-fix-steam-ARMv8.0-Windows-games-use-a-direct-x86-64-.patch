From 09d50aac91e64605ec5e7096ebe04e6915d646d0 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 20:53:14 +0000
Subject: [PATCH 7/8] fix(steam): ARMv8.0 Windows games use a direct x86-64
 Proton tool, not the container

Under proot the Steam Linux Runtime container has no namespaces, which is why the x86-64
client already runs Linux games on droiddeck-direct. On an ARMv8.0 CPU it now writes
droiddeck-proton-x64: Valve's x86-64 Proton (Experimental, else 10.0/9.0/8.0) started
directly under FEX with the client's game GPU environment. It is the default there, titles
on Valve's container Protons or on a removed arm64 bridge move to it, and Proton
Experimental is requested from the client when none is installed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../overlay/usr/local/bin/droiddeck-steam-x64 | 75 ++++++++++++++++++-
 .../overlay/usr/local/bin/steam-compatibility | 18 ++---
 tools/tests/test_armv80_steam.py              | 74 ++++++++++++++----
 3 files changed, 138 insertions(+), 29 deletions(-)

diff --git a/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64 b/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
index c370fe7..5997e50 100755
--- a/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
+++ b/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
@@ -24,8 +24,76 @@ x64_default_dir() {
            ls -d "$STEAM_X64"/compatibilitytools.d/GE-Proton*-aarch64 2>/dev/null | sort -V -r)
   echo "$STEAM_X64/compatibilitytools.d/droiddeck-proton-arm64"
 }
-# Every arm64 Proton build uses ARMv8.1 atomics, so an ARMv8.0 CPU runs Valve's x86-64 Proton under FEX.
-X64_ARMV80_TOOL=proton_experimental
+# Every arm64 Proton build uses ARMv8.1 atomics, so an ARMv8.0 CPU runs Valve's x86-64 Proton under
+# FEX, started directly like droiddeck-direct: proot gives the Steam Linux Runtime container no namespaces.
+X64_ARMV80_TOOL=droiddeck-proton-x64
+X64_PROTON_EXPERIMENTAL_APPID=1493710
+x64_valve_proton() {
+  local common name
+  for common in "$STEAM_X64/steamapps/common" /mnt/droiddeck-sd/x86-64/steamapps/common \
+                "$X64_HOME/shared/arm64/steamapps/common" /mnt/droiddeck-lib/*/x86-64/steamapps/common; do
+    for name in "Proton - Experimental" "Proton 10.0" "Proton 9.0" "Proton 8.0"; do
+      [ -f "$common/$name/proton" ] && { echo "$common/$name/proton"; return 0; }
+    done
+  done
+  return 1
+}
+x64_write_armv80_tool() {
+  local tool=$STEAM_X64/compatibilitytools.d/$X64_ARMV80_TOOL
+  mkdir -p "$tool"
+  cat > "$tool/compatibilitytool.vdf" <<VDF
+"compatibilitytools"
+{
+  "compat_tools"
+  {
+    "$X64_ARMV80_TOOL"
+    {
+      "install_path" "."
+      "display_name" "DroidDeck Proton x86-64 (FEX, no container)"
+      "from_oslist" "windows"
+      "to_oslist" "linux"
+    }
+  }
+}
+VDF
+  cat > "$tool/toolmanifest.vdf" <<'VDF'
+"manifest"
+{
+  "version" "2"
+  "commandline" "/run %verb%"
+}
+VDF
+  cat > "$tool/run" <<'RUN'
+#!/bin/sh
+# Valve's x86-64 Proton under FEX, without the Steam Linux Runtime container.
+verb=$1; shift
+gpu=$HOME/game-gpu.env
+if [ -f "$gpu" ] && [ "${BL_X64_GAME_SOFTWARE:-0}" != 1 ]; then
+  . "$gpu"
+  [ -f "$HOME/game-gpu.local" ] && . "$HOME/game-gpu.local"
+else
+  export mesa_glthread=false
+fi
+proton=
+for common in "$HOME/.local/share/Steam/steamapps/common" /mnt/droiddeck-sd/x86-64/steamapps/common \
+              "$HOME/shared/arm64/steamapps/common" /mnt/droiddeck-lib/*/x86-64/steamapps/common; do
+  for name in "Proton - Experimental" "Proton 10.0" "Proton 9.0" "Proton 8.0"; do
+    [ -z "$proton" ] && [ -f "$common/$name/proton" ] && proton=$common/$name/proton
+  done
+done
+if [ -z "$proton" ]; then
+  echo "droiddeck-proton-x64: no Valve Proton installed; install Proton Experimental (Library > Tools)" >&2
+  exit 1
+fi
+exec python3 "$proton" "$verb" "$@"
+RUN
+  chmod 755 "$tool/run"
+  if ! x64_valve_proton >/dev/null; then
+    grep -qx "steam://install/$X64_PROTON_EXPERIMENTAL_APPID" "$REAL_HOME/.bl-steam-urls" 2>/dev/null ||
+      echo "steam://install/$X64_PROTON_EXPERIMENTAL_APPID" >> "$REAL_HOME/.bl-steam-urls"
+    step "asking the x86-64 client to install Proton Experimental for $X64_ARMV80_TOOL"
+  fi
+}
 x64_default_tool() {
   if ! x64_arm64_builds_supported; then echo "$X64_ARMV80_TOOL"; return; fi
   sed -n 's/^[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p' "$(x64_default_dir)/compatibilitytool.vdf" 2>/dev/null |
@@ -540,6 +608,9 @@ RUN
   if ! x64_arm64_builds_supported; then
     arm64_builds=0
     step "this CPU has no ARMv8.1 atomics: arm64 Proton cannot run here, so Windows games use $X64_ARMV80_TOOL under FEX"
+    x64_write_armv80_tool
+  else
+    rm -rf "$STEAM_X64/compatibilitytools.d/$X64_ARMV80_TOOL"
   fi
   for w in "$STEAM_X64"/compatibilitytools.d/*/.droiddeck-arm64-proton; do
     [ -e "$w" ] || continue
