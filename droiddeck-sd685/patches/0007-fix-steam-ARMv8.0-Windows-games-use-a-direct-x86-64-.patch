+class DirectProtonRunTest(Armv80Case):
+    def write_tool(self, with_proton):
+        steam = self.root / 'home/.local/share/Steam'
+        if with_proton:
+            proton = steam / 'steamapps/common/Proton - Experimental'
+            proton.mkdir(parents=True)
+            (proton / 'proton').write_text('import sys\nprint("proton", *sys.argv[1:])\n')
+        functions = between(X64, 'X64_ARMV80_TOOL=', 'x64_default_tool() {')
+        script = 'step() { :; }\n' + functions + 'x64_write_armv80_tool\n'
+        result = self.bash(script, env={'STEAM_X64': str(steam), 'X64_HOME': str(self.root / 'home'),
+                                        'REAL_HOME': str(self.root)})
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return steam / 'compatibilitytools.d/droiddeck-proton-x64/run'
+
+    def test_run_starts_valve_proton_with_the_verb(self):
+        run = self.write_tool(True)
+        result = subprocess.run([str(run), 'waitforexitandrun', 'Z:\\game.exe'], capture_output=True, text=True,
+                                env=dict(os.environ, HOME=str(self.root / 'home')))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout.strip(), 'proton waitforexitandrun Z:\\game.exe')
+        self.assertFalse((self.root / '.bl-steam-urls').exists())
+
+    def test_run_without_a_proton_says_what_to_install(self):
+        run = self.write_tool(False)
+        result = subprocess.run([str(run), 'waitforexitandrun', 'game.exe'], capture_output=True, text=True,
+                                env=dict(os.environ, HOME=str(self.root / 'home')))
+        self.assertEqual(result.returncode, 1)
+        self.assertIn('Proton Experimental', result.stderr)
 
 
