diff --git a/tools/sd685/stage_release_inputs.sh b/tools/sd685/stage_release_inputs.sh
new file mode 100755
index 0000000..dc736bb
--- /dev/null
+++ b/tools/sd685/stage_release_inputs.sh
@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+# Stages the prebuilt, unmodified native inputs of an official DroidDeck APK into the generated
+# (git-ignored) paths that tools/build_local.sh normally fills through Docker cross-builds.
+# Only use an APK built from the same source commit: these files are taken byte for byte.
+#
+#   tools/sd685/stage_release_inputs.sh DroidDeck-0.7.1.apk
+#
+# Session scripts are not taken from the APK: Gradle's stageSessionScripts copies them from
+# tools/linuxfs/overlay, so source changes there always reach the built APK.
+set -euo pipefail
+
+apk=${1:?usage: stage_release_inputs.sh <official apk>}
+repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+unzip -q "$apk" 'assets/*' 'lib/*' -d "$work"
+
+assets=$repo_root/app/src/main/assets
+prepared=$repo_root/app/build/prepared-assets
+jni=$repo_root/app/src/main/jniLibs/arm64-v8a
+
+rm -rf "$assets/linuxfs" "$assets/droiddeck-esync"
+mkdir -p "$assets" "$prepared/graphics_driver" "$jni"
+cp -a "$work/assets/linuxfs" "$assets/linuxfs"
+cp -a "$work/assets/droiddeck-esync" "$assets/droiddeck-esync"
+cp -f "$work/assets/pulseaudio.tzst" "$prepared/pulseaudio.tzst"
+for name in turnip25.1.0-quest1 turnip26.3.0-a6xx turnip26.3.0-quest2; do
+    cp -f "$work/assets/graphics_driver/adrenotools-$name.tzst" "$prepared/graphics_driver/"
+done
+for lib in libdirectaudiorelay.so libsyncthingnative.so; do
+    install -m755 "$work/lib/arm64-v8a/$lib" "$jni/$lib"
+done
+if [[ "${STAGE_STORES:-0}" == 1 ]]; then
+    mkdir -p "$repo_root/app/build/rustJniLibs/arm64-v8a"
+    install -m755 "$work/lib/arm64-v8a/libdroiddeckstores.so" "$repo_root/app/build/rustJniLibs/arm64-v8a/"
+fi
+
+# The add-on packs are not in the APK; the app downloads them by digest. Their contents are
+# runtime inputs the build verifies, so fetch the release's own archives and unpack them in place.
+pins=${PACK_PINS:-$repo_root/tools/sd685/addon-packs-0.7.1.properties}
+pin() { sed -n "s/^$1\\.$2=//p" "$pins"; }
+declare -A pack_dest=(
+    [proot]=app/src/main/jniLibs/arm64-v8a
+    [directaudio]=app/src/main/assets/directaudio
+    [xbox]=app/src/main/assets/linuxfs/usr/local/lib/droiddeck-xbox
+    [comet]=app/src/main/assets/linuxfs/usr/local/lib/droiddeck-comet
+    [powervr]=app/src/main/assets/hybris
+)
+for name in proot directaudio xbox comet powervr; do
+    sha=$(pin "$name" sha256)
+    [[ -n "$sha" ]] || { echo "no pin for the $name pack in $pins" >&2; exit 1; }
+    archive=$work/$name.tar.zst
+    curl -fsSL --retry 4 -o "$archive" \
+        "https://github.com/Droid-Deck/DroidDeck-Components/releases/download/pack-$name-${sha:0:16}/$name.tar.zst"
+    echo "$sha  $archive" | sha256sum -c --quiet
+    dest=$repo_root/${pack_dest[$name]}
+    [[ "$name" == proot ]] || rm -rf "$dest"
+    mkdir -p "$dest"
+    zstd -dc "$archive" | tar -xf - -C "$dest"
+    echo "pack $name ${sha:0:16} -> ${pack_dest[$name]}"
+done
+echo "staged: $(find "$assets/linuxfs" -type f | wc -l) linuxfs files, esync packs, pulseaudio bundle, turnip archives, jniLibs, add-on packs"
