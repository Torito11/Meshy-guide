From 4ccc06ae778dcc3188117c2dcfae5fb4e5262a32 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 20:17:31 +0000
Subject: [PATCH 1/8] build: stage an official release's unmodified native
 inputs and pin its add-on packs

tools/sd685/stage_release_inputs.sh fills the generated, git-ignored inputs that
tools/build_local.sh builds through Docker with the byte-identical files of a
release APK built from the same commit, and fetches that release's add-on packs
by digest. -PaddonPackPins makes BuildConfig name the same packs as the release.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/build.gradle                         | 12 +++++
 tools/sd685/addon-packs-0.7.1.properties | 17 +++++++
 tools/sd685/stage_release_inputs.sh      | 63 ++++++++++++++++++++++++
 3 files changed, 92 insertions(+)
 create mode 100644 tools/sd685/addon-packs-0.7.1.properties
 create mode 100755 tools/sd685/stage_release_inputs.sh

diff --git a/app/build.gradle b/app/build.gradle
index c87e709..7f5377c 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -93,10 +93,22 @@ def trackingPack = rootProject.file('tools/packs/tracking/release.env').readLine
 def prootPackPin = rootProject.file('tools/packs/proot/release.env').readLines()
     .findAll { it.contains('=') && !it.startsWith('#') }
     .collectEntries { def kv = it.split('=', 2); [(kv[0].trim()): kv[1].trim()] }
+// Pins the packs a release published (tools/sd685/addon-packs-<version>.properties), so a build that
+// does not rebuild them downloads and verifies the same archives as that release.
+def addonPackPinsPath = project.findProperty('addonPackPins') ?: localBuildOptions.getProperty('droiddeck.addonPackPins', '')
+def addonPackPins = new Properties()
+if (addonPackPinsPath) {
+    def pinsFile = rootProject.file(addonPackPinsPath)
+    if (!pinsFile.isFile()) throw new GradleException("addonPackPins file ${pinsFile} does not exist")
+    addonPackPins.load(new StringReader(providers.fileContents(rootProject.layout.projectDirectory.file(addonPackPinsPath)).asText.get()))
+}
 def addonPacks = ['proot', 'directaudio', 'tracking', 'xbox', 'comet', 'butler', 'powervr'].collectEntries { name ->
     def pack = file("build/packs/${name}.tar.zst")
     if (!pack.isFile()) {
         if (ciBuild) throw new GradleException("Add-on pack ${pack} is missing: run tools/packs/build.sh app/build/packs")
+        if (addonPackPins.getProperty("${name}.sha256")) {
+            return [(name): [sha256: addonPackPins.getProperty("${name}.sha256"), size: (addonPackPins.getProperty("${name}.size") ?: '0') as long]]
+        }
         if (name == 'proot' && prootPackPin.PROOT_PACK_SHA256) {
             return [(name): [sha256: prootPackPin.PROOT_PACK_SHA256, size: (prootPackPin.PROOT_PACK_SIZE ?: '0') as long]]
         }
diff --git a/tools/sd685/addon-packs-0.7.1.properties b/tools/sd685/addon-packs-0.7.1.properties
