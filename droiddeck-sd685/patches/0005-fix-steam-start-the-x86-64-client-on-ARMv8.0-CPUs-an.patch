diff --git a/app/src/test/java/com/droiddeck/launcher/core/CpuFeaturesTest.kt b/app/src/test/java/com/droiddeck/launcher/core/CpuFeaturesTest.kt
new file mode 100644
index 0000000..e178bb7
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/core/CpuFeaturesTest.kt
@@ -0,0 +1,69 @@
+package com.droiddeck.launcher.core
+
+import com.droiddeck.launcher.gpu.GpuInfo
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class CpuFeaturesTest {
+    private fun auxv(vararg pairs: Pair<Long, Long>): ByteArray {
+        val buffer = ByteBuffer.allocate((pairs.size + 1) * 16).order(ByteOrder.LITTLE_ENDIAN)
+        pairs.forEach { (type, value) -> buffer.putLong(type).putLong(value) }
+        buffer.putLong(0L).putLong(0L)
+        return buffer.array()
+    }
+
+    // The Redmi Note 13 (Snapdragon 685: Cortex-A73 + A53) report, as the kernel lists it.
+    private val snapdragon685 = """
+        processor : 0
+        Features : fp asimd evtstrm aes pmull sha1 sha2 crc32 cpuid
+        processor : 4
+        Features : fp asimd evtstrm aes pmull sha1 sha2 crc32 cpuid
+    """.trimIndent()
+
+    @Test fun hwcapWithoutAtomicsIsArmv80() {
+        // HWCAP_FP | HWCAP_ASIMD | HWCAP_AES | HWCAP_PMULL | HWCAP_SHA1 | HWCAP_SHA2 | HWCAP_CRC32 | HWCAP_CPUID
+        val hwcap = 0b1L or 0b10L or (1L shl 3) or (1L shl 4) or (1L shl 5) or (1L shl 6) or (1L shl 7) or (1L shl 11)
+        assertEquals(CpuFeatures.Lse.ABSENT, CpuFeatures.lseFromAuxv(auxv(6L to 4096L, 16L to hwcap)))
+    }
+
+    @Test fun hwcapWithAtomicsIsLse() {
+        assertEquals(CpuFeatures.Lse.PRESENT, CpuFeatures.lseFromAuxv(auxv(16L to (1L shl 8 or 0b11L))))
+    }
+
+    @Test fun auxvWithoutHwcapOrTooShortSaysNothing() {
+        assertEquals(CpuFeatures.Lse.UNKNOWN, CpuFeatures.lseFromAuxv(auxv(6L to 4096L)))
+        assertEquals(CpuFeatures.Lse.UNKNOWN, CpuFeatures.lseFromAuxv(ByteArray(8)))
+        assertEquals(CpuFeatures.Lse.UNKNOWN, CpuFeatures.lseFromAuxv(null))
+    }
+
+    @Test fun cpuInfoOfTheSnapdragon685LacksAtomics() {
+        assertEquals(CpuFeatures.Lse.ABSENT, CpuFeatures.lseFromCpuInfo(snapdragon685))
+    }
+
+    @Test fun everyCoreMustListTheExactToken() {
+        assertEquals(CpuFeatures.Lse.PRESENT, CpuFeatures.lseFromCpuInfo("Features : fp asimd atomics\nFeatures : fp atomics lrcpc"))
+        assertEquals(CpuFeatures.Lse.ABSENT, CpuFeatures.lseFromCpuInfo("Features : fp atomics\nFeatures : fp asimd"))
+        assertEquals(CpuFeatures.Lse.ABSENT, CpuFeatures.lseFromCpuInfo("Features : fp noatomics atomics_extra"))
+        assertEquals(CpuFeatures.Lse.UNKNOWN, CpuFeatures.lseFromCpuInfo("processor : 0\n"))
+        assertEquals(CpuFeatures.Lse.UNKNOWN, CpuFeatures.lseFromCpuInfo(null))
+    }
+
+    @Test fun auxvWinsOverCpuInfoAndCpuInfoFillsIn() {
+        assertEquals(CpuFeatures.Lse.ABSENT, CpuFeatures.combine(CpuFeatures.Lse.ABSENT, CpuFeatures.Lse.PRESENT))
+        assertEquals(CpuFeatures.Lse.ABSENT, CpuFeatures.combine(CpuFeatures.Lse.UNKNOWN, CpuFeatures.Lse.ABSENT))
+        assertEquals(CpuFeatures.Lse.UNKNOWN, CpuFeatures.combine(CpuFeatures.Lse.UNKNOWN, CpuFeatures.Lse.UNKNOWN))
+    }
+
+    @Test fun lowTierCoversArmv80CpusAndSmallAdreno6xx() {
+        assertTrue(LowTierDevice.isLowTier(GpuInfo.Family.A6XX, 610, armv80Only = false))
+        assertTrue(LowTierDevice.isLowTier(GpuInfo.Family.A6XX, 619, armv80Only = false))
+        assertTrue(LowTierDevice.isLowTier(GpuInfo.Family.A7XX, 740, armv80Only = true))
+        assertFalse(LowTierDevice.isLowTier(GpuInfo.Family.A6XX, 650, armv80Only = false))
+        assertFalse(LowTierDevice.isLowTier(GpuInfo.Family.A7XX, 730, armv80Only = false))
+        assertFalse(LowTierDevice.isLowTier(GpuInfo.Family.MALI_OTHER, 0, armv80Only = false))
+    }
+}
diff --git a/app/src/test/java/com/droiddeck/launcher/session/LowTierSessionPrefsTest.kt b/app/src/test/java/com/droiddeck/launcher/session/LowTierSessionPrefsTest.kt
new file mode 100644
index 0000000..2a2ace5
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/session/LowTierSessionPrefsTest.kt
@@ -0,0 +1,49 @@
+package com.droiddeck.launcher.session
+
+import com.droiddeck.launcher.stores.xbox.XboxCloudSettings
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner::class)
+@org.robolectric.annotation.Config(sdk = [33], application = android.app.Application::class)
+class LowTierSessionPrefsTest {
+    @Test fun armv80CpusAlwaysGetTheX64Client() {
+        assertEquals("x86_64", SessionPrefs.effectiveSteamClientArch("arm64", armv80Only = true))
+        assertEquals("x86_64", SessionPrefs.effectiveSteamClientArch("x86_64", armv80Only = true))
+        assertEquals("x86_64", SessionPrefs.effectiveSteamClientArch("something-else", armv80Only = true))
+    }
+
+    @Test fun lseCpusKeepTheirChoice() {
+        assertEquals("arm64", SessionPrefs.effectiveSteamClientArch("arm64", armv80Only = false))
+        assertEquals("x86_64", SessionPrefs.effectiveSteamClientArch("x86_64", armv80Only = false))
+    }
+
+    @Test fun lowTierStartsAt60HzOthersAtThePanelMaximum() {
+        assertEquals(60, SessionPrefs.defaultRefreshCap(lowTier = true))
+        assertEquals(0, SessionPrefs.defaultRefreshCap(lowTier = false))
+    }
+
+    @Test fun theLowestSetLimitWins() {
+        assertEquals(0, SessionPrefs.refreshLimit(0, 0))
+        assertEquals(60, SessionPrefs.refreshLimit(0, 60))
+        assertEquals(45, SessionPrefs.refreshLimit(45, 60))
+        assertEquals(60, SessionPrefs.refreshLimit(90, 60))
+        assertEquals(72, SessionPrefs.refreshLimit(72, 0))
+    }
+
+    @Test fun lowTierXcloudStartsWithoutFrameGenerationButKeepsASavedChoice() {
+        val defaults = XboxCloudSettings()
+        assertEquals("off", XboxCloudSettings.withDeviceDefaults(defaults, null, lowTier = true).frameGen)
+        assertEquals("ddfg", XboxCloudSettings.withDeviceDefaults(defaults, null, lowTier = false).frameGen)
+        val savedWithout = """{"resolution":"720p"}"""
+        assertEquals("off", XboxCloudSettings.withDeviceDefaults(XboxCloudSettings.decode(savedWithout), savedWithout, lowTier = true).frameGen)
+        val savedDdfg = """{"frameGen":"ddfg"}"""
+        assertEquals("ddfg", XboxCloudSettings.withDeviceDefaults(XboxCloudSettings.decode(savedDdfg), savedDdfg, lowTier = true).frameGen)
+        val savedLsfg = """{"frameGen":"lsfg"}"""
+        assertEquals("lsfg", XboxCloudSettings.withDeviceDefaults(XboxCloudSettings.decode(savedLsfg), savedLsfg, lowTier = false).frameGen)
+    }
+
+    @Test fun refreshCapIsResetWithTheOtherSessionSettings() {
+        assertEquals(true, SettingsReset.isSessionSetting("refreshCap"))
+    }
+}
