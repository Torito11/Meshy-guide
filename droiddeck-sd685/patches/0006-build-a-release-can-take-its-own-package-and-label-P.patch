From 596b35a7df9be25754993bfcf48533001e37db9e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 20 Nov 2026 20:41:50 +0000
Subject: [PATCH 6/8] build: a release can take its own package and label
 (-PreleaseApplicationIdSuffix)

An APK not signed with DroidDeck's key cannot update an official install: its v3
lineage refuses the testkey. A suffixed package installs beside it with its own data.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/build.gradle                 | 10 ++++++++++
 app/src/main/AndroidManifest.xml |  2 +-
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/app/build.gradle b/app/build.gradle
index 7f5377c..06378f0 100644
--- a/app/build.gradle
+++ b/app/build.gradle
@@ -145,6 +145,7 @@ android {
         targetSdkVersion 28
         versionCode 19
         versionName "0.7.1"
+        manifestPlaceholders = [appLabel: '@string/app_name']
         buildConfigField "String", "BUILD_LABEL", "\"${escapedBuildLabel}\""
         buildConfigField "String", "SOURCE_COMMIT", "\"${sourceCommit}\""
         buildConfigField "int", "PR_NUMBER", "${prNumber}"
@@ -209,6 +210,15 @@ android {
         release {
             minifyEnabled false
             signingConfig signingConfigs.testkey
+            // A build not signed with DroidDeck's key cannot update an official install (its v3 lineage
+            // refuses the testkey), so it can take its own package and sit beside it with its own data.
+            def releaseIdSuffix = (project.findProperty('releaseApplicationIdSuffix')
+                ?: localBuildOptions.getProperty('droiddeck.releaseApplicationIdSuffix', '')).toString()
+            if (releaseIdSuffix) {
+                applicationIdSuffix releaseIdSuffix
+                versionNameSuffix "-" + releaseIdSuffix.replaceFirst(/^\./, '')
+                manifestPlaceholders = [appLabel: (project.findProperty('releaseAppLabel') ?: "DroidDeck ${releaseIdSuffix.replaceFirst(/^\./, '').toUpperCase()}").toString()]
+            }
         }
     }
 
diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index d5bb0dc..526751e 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -58,7 +58,7 @@
         android:allowBackup="false"
         android:allowAudioPlaybackCapture="true"
         android:icon="@mipmap/ic_launcher"
-        android:label="@string/app_name"
+        android:label="${appLabel}"
         android:theme="@style/AppTheme"
         android:hardwareAccelerated="true"
         android:largeHeap="true"
-- 
