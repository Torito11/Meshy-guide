+/** The hardware H.264 decoder and whether it decodes 1080p at 60 fps, as Android reports them. */
+internal fun avcDecoder(): Pair<String, Boolean>? = runCatching {
+    MediaCodecList(MediaCodecList.REGULAR_CODECS).codecInfos
+        .filter { !it.isEncoder && it.supportedTypes.any { t -> t.equals("video/avc", true) } }
+        .sortedByDescending { hardware(it) }
+        .firstOrNull()
+        ?.let { info ->
+            val caps = info.getCapabilitiesForType("video/avc").videoCapabilities
+            info.name to (caps?.areSizeAndRateSupported(1920, 1080, 60.0) == true)
+        }
+}.getOrNull()
+
+private fun hardware(info: MediaCodecInfo): Boolean =
+    if (Build.VERSION.SDK_INT >= 29) info.isHardwareAccelerated
+    else !info.name.startsWith("OMX.google.") && !info.name.startsWith("c2.android.")
+
+@Composable
+internal fun CloudStatsSection() {
+    val context = LocalContext.current
+    var refresh by remember { mutableIntStateOf(0) }
+    var measuring by remember { mutableStateOf(false) }
+    val scope = rememberCoroutineScope()
+    LaunchedEffect(Unit) { while (true) { delay(2000); refresh++ } }
+    val stats = remember(refresh) { XboxCloudStats.last(context) }
+    val probes = remember(refresh) { XboxCloudNetwork.saved(context) }
+    val decoder = remember { avcDecoder() }
+    val dim = MaterialTheme.colorScheme.onSurfaceVariant
+    Column(Modifier.fillMaxWidth()) {
+        if (stats == null) {
+            Text(stringResource(R.string.xcloud_stats_none), style = MaterialTheme.typography.bodySmall, color = dim)
+        } else {
+            val unknown = stringResource(R.string.xcloud_stats_unknown)
+            fun <T> or(v: T?, f: (T) -> String) = v?.let(f) ?: unknown
+            val state = when (stats.state) {
+                "streaming" -> stringResource(R.string.xcloud_state_streaming); "connecting" -> stringResource(R.string.xcloud_state_connecting)
+                "reconnecting" -> stringResource(R.string.xcloud_state_reconnecting); "failed" -> stringResource(R.string.xcloud_state_failed)
+                else -> stringResource(R.string.xcloud_state_ended)
+            }
+            val quality = when (XboxCloudStats.quality(stats)) {
+                "excellent" -> stringResource(R.string.xcloud_quality_excellent); "good" -> stringResource(R.string.xcloud_quality_good)
+                "fair" -> stringResource(R.string.xcloud_quality_fair); "poor" -> stringResource(R.string.xcloud_quality_poor)
+                else -> unknown
+            }
+            val lines = listOf(
+                stringResource(R.string.xcloud_stats_state, state, DateFormat.getTimeInstance(DateFormat.SHORT).format(Date(stats.at)),
+                    if (stats.engine == "native") stringResource(R.string.xcloud_engine_native) else stringResource(R.string.xcloud_engine_web)),
+                stringResource(R.string.xcloud_stats_region, stats.region ?: unknown),
+                stringResource(R.string.xcloud_stats_video, if (stats.width != null && stats.height != null) "${stats.width}×${stats.height}" else unknown,
+                    or(stats.fps) { "$it" }, stats.codec ?: unknown),
+                stringResource(R.string.xcloud_stats_network, or(stats.rttMs) { "$it ms" }, or(stats.jitterMs) { "$it ms" },
+                    or(stats.lossPct) { String.format("%.1f %%", it) }),
+                stringResource(R.string.xcloud_stats_bitrate, or(stats.mbps) { String.format("%.1f Mb/s", it) },
+                    if (stats.capMbps > 0) "${stats.capMbps} Mb/s" else stringResource(R.string.xcloud_stats_no_cap),
+                    or(stats.decodeMs) { String.format("%.1f ms", it) }),
+                stringResource(R.string.xcloud_stats_quality, quality),
+            )
+            lines.forEach { Text(it, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurface) }
+        }
+        decoder?.let { (name, fullHd) ->
+            Text(stringResource(if (fullHd) R.string.xcloud_decoder_1080 else R.string.xcloud_decoder_no_1080, name),
+                style = MaterialTheme.typography.bodySmall, color = dim, modifier = Modifier.padding(top = 4.dp))
+        }
+        Text(stringResource(R.string.xcloud_regions_title), style = MaterialTheme.typography.bodyMedium, modifier = Modifier.padding(top = 8.dp))
+        if (probes == null) {
+            Text(stringResource(R.string.xcloud_regions_none), style = MaterialTheme.typography.bodySmall, color = dim)
+        } else {
+            val chosen = XboxCloudNetwork.choose(probes.second)?.region
+            probes.second.sortedBy { it.medianMs ?: Int.MAX_VALUE }.forEach { p ->
+                val ms = p.medianMs?.let { stringResource(R.string.xcloud_region_ms, it, p.spreadMs ?: 0) } ?: stringResource(R.string.xcloud_region_no_answer)
+                val marks = listOfNotNull(stringResource(R.string.xcloud_region_default).takeIf { p.isDefault },
+                    stringResource(R.string.xcloud_region_chosen).takeIf { p.region == chosen }).joinToString(" · ")
+                Text("${p.region}: $ms" + if (marks.isNotEmpty()) "  ($marks)" else "", style = MaterialTheme.typography.bodySmall)
+            }
+            Text(stringResource(R.string.xcloud_regions_rule, XboxCloudNetwork.MIN_GAIN_MS, (XboxCloudNetwork.MIN_GAIN_SHARE * 100).toInt()),
+                style = MaterialTheme.typography.bodySmall, color = dim)
+        }
+        OutlinedButton(enabled = !measuring, modifier = Modifier.padding(top = 6.dp).focusGlide(CircleShape), onClick = {
+            measuring = true
+            scope.launch {
+                withContext(Dispatchers.IO) { measure(context) }
+                measuring = false
+                refresh++
+            }
+        }) { Text(stringResource(if (measuring) R.string.xcloud_regions_measuring else R.string.xcloud_regions_measure)) }
+        Text(stringResource(R.string.xcloud_regions_note), style = MaterialTheme.typography.bodySmall, color = dim, modifier = Modifier.padding(top = 4.dp))
+    }
+}
+
+private fun measure(context: Context) {
+    runCatching {
+        val account = StoreAccounts.signedInAs(context.applicationContext, Store.XBOX) ?: return
+        val session = XboxCloudSession.get(context.applicationContext, account)
+        XboxCloudNetwork.save(context, XboxCloudNetwork.probe(session.regionList))
+    }
+}
