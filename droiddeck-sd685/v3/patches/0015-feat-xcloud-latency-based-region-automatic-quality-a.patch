+package com.droiddeck.launcher.stores.xbox
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import kotlin.math.roundToInt
+
+/**
+ * What a cloud stream measured, from WebRTC's own statistics (both players): resolution, frames per second,
+ * codec, round trip, network jitter, packet loss, bitrate, decode time, dropped frames, the region and the stream's
+ * state. Only values WebRTC reports are kept; a value it does not report stays null and is shown as unknown.
+ * The last stream and a short history are saved, for the settings page and for the next stream's automatic quality.
+ */
+internal object XboxCloudStats {
+    private const val PREFS = "xbox_cloud_stats"
+    private const val LAST = "last"
+    private const val HISTORY = "history"
+    private const val KEEP = 10
+
+    data class Snapshot(
+        val at: Long, val engine: String, val region: String?, val state: String,
+        val width: Int? = null, val height: Int? = null, val fps: Int? = null, val codec: String? = null,
+        val rttMs: Int? = null, val jitterMs: Int? = null, val lossPct: Double? = null, val mbps: Double? = null,
+        val decodeMs: Double? = null, val framesDropped: Long? = null, val capMbps: Int = 0,
+    ) {
+        fun toJson(): JSONObject = JSONObject().put("at", at).put("engine", engine).put("region", region ?: JSONObject.NULL)
+            .put("state", state).put("width", width ?: JSONObject.NULL).put("height", height ?: JSONObject.NULL)
+            .put("fps", fps ?: JSONObject.NULL).put("codec", codec ?: JSONObject.NULL).put("rttMs", rttMs ?: JSONObject.NULL)
+            .put("jitterMs", jitterMs ?: JSONObject.NULL).put("lossPct", lossPct ?: JSONObject.NULL).put("mbps", mbps ?: JSONObject.NULL)
+            .put("decodeMs", decodeMs ?: JSONObject.NULL).put("framesDropped", framesDropped ?: JSONObject.NULL).put("capMbps", capMbps)
+
+        companion object {
+            fun fromJson(o: JSONObject) = Snapshot(
+                o.optLong("at"), o.optString("engine"), o.optString("region").takeIf { !o.isNull("region") && it.isNotEmpty() },
+                o.optString("state"), o.intOrNull("width"), o.intOrNull("height"), o.intOrNull("fps"),
+                o.optString("codec").takeIf { !o.isNull("codec") && it.isNotEmpty() }, o.intOrNull("rttMs"), o.intOrNull("jitterMs"),
+                o.doubleOrNull("lossPct"), o.doubleOrNull("mbps"), o.doubleOrNull("decodeMs"),
+                if (o.isNull("framesDropped") || !o.has("framesDropped")) null else o.optLong("framesDropped"), o.optInt("capMbps"),
+            )
+        }
+    }
+
+    /** One stream's average, for the next stream's quality. */
+    data class Summary(val at: Long, val engine: String, val region: String?, val rttMs: Int?, val lossPct: Double?, val mbps: Double?, val capMbps: Int)
+
+    /** A WebRTC stats entry, as both players read it. Times in milliseconds. */
+    class Entry(val type: String, val id: String, val timestampMs: Double, val members: Map<String, Any?>)
+
+    /** Turns successive getStats() reports into snapshots; rates come from the change since the previous report. */
+    class Reader(private val engine: String) {
+        private var lastBytes = -1.0; private var lastMs = -1.0; private var lastLost = -1.0; private var lastReceived = -1.0
+        private var lastDecode = -1.0; private var lastDecoded = -1.0
+        private val rtts = ArrayList<Int>(); private val losses = ArrayList<Double>(); private val rates = ArrayList<Double>()
+
+        fun read(entries: List<Entry>, region: String?, state: String, capMbps: Int, now: Long = System.currentTimeMillis()): Snapshot {
+            val codecs = entries.filter { it.type == "codec" }.associate { it.id to (it.members["mimeType"] as? String).orEmpty().removePrefix("video/") }
+            val video = entries.firstOrNull { it.type == "inbound-rtp" && (it.members["kind"] ?: it.members["mediaType"]) == "video" }
+            val pair = entries.firstOrNull { it.type == "candidate-pair" && it.members["state"] == "succeeded" && it.members["nominated"] == true }
+            val rtt = (pair?.members?.get("currentRoundTripTime") as? Number)?.toDouble()?.let { (it * 1000).roundToInt() }
+            var mbps: Double? = null; var loss: Double? = null; var decodeMs: Double? = null
+            if (video != null) {
+                val m = video.members
+                val bytes = (m["bytesReceived"] as? Number)?.toDouble()
+                if (bytes != null) {
+                    if (lastBytes >= 0 && video.timestampMs > lastMs) mbps = (bytes - lastBytes) * 8 / ((video.timestampMs - lastMs) * 1000)
+                    lastBytes = bytes; lastMs = video.timestampMs
+                }
+                val lost = (m["packetsLost"] as? Number)?.toDouble(); val received = (m["packetsReceived"] as? Number)?.toDouble()
+                if (lost != null && received != null) {
+                    if (lastLost >= 0) { val dl = lost - lastLost; val dr = received - lastReceived; if (dl + dr > 0) loss = (dl * 100 / (dl + dr)).coerceIn(0.0, 100.0) }
+                    lastLost = lost; lastReceived = received
+                }
+                val dt = (m["totalDecodeTime"] as? Number)?.toDouble(); val df = (m["framesDecoded"] as? Number)?.toDouble()
+                if (dt != null && df != null) {
+                    if (lastDecoded >= 0 && df > lastDecoded) decodeMs = (dt - lastDecode) * 1000 / (df - lastDecoded)
+                    lastDecode = dt; lastDecoded = df
+                }
+            }
+            rtt?.let { rtts += it }; loss?.let { losses += it }; mbps?.let { rates += it }
+            val m = video?.members.orEmpty()
+            return Snapshot(now, engine, region, state, (m["frameWidth"] as? Number)?.toInt(), (m["frameHeight"] as? Number)?.toInt(),
+                (m["framesPerSecond"] as? Number)?.toDouble()?.roundToInt(), codecs[m["codecId"] as? String]?.takeIf { it.isNotEmpty() },
+                rtt, (m["jitter"] as? Number)?.toDouble()?.let { (it * 1000).roundToInt() }, loss, mbps, decodeMs,
+                (m["framesDropped"] as? Number)?.toLong(), capMbps)
+        }
+
+        /** The stream so far, averaged; null before WebRTC reported anything. */
+        fun summary(region: String?, capMbps: Int, now: Long = System.currentTimeMillis()): Summary? {
+            if (rtts.isEmpty() && losses.isEmpty() && rates.isEmpty()) return null
+            return Summary(now, engine, region, rtts.takeIf { it.isNotEmpty() }?.sorted()?.let { it[it.size / 2] },
+                losses.takeIf { it.isNotEmpty() }?.average(), rates.takeIf { it.isNotEmpty() }?.average(), capMbps)
+        }
+    }
+
+    /** The web player's report (see XboxCloudPlayerActivity.STATS_SHIM): [{type, id, timestamp, members}]. */
+    fun entries(json: String): List<Entry> {
+        val array = JSONArray(json)
+        return (0 until array.length()).mapNotNull { array.optJSONObject(it) }.map { o ->
+            val m = o.optJSONObject("members") ?: JSONObject()
+            val members = m.keys().asSequence().associateWith { k -> m.get(k).takeIf { it != JSONObject.NULL } }
+            Entry(o.optString("type"), o.optString("id"), o.optDouble("timestamp", 0.0), members)
+        }
+    }
+
+    @Volatile var live: Snapshot? = null
+        private set
+
+    fun update(context: Context, snapshot: Snapshot) {
+        live = snapshot
+        runCatching { prefs(context).edit().putString(LAST, snapshot.toJson().toString()).apply() }
+    }
+
+    fun ended(context: Context, summary: Summary?) {
+        live = live?.copy(state = "ended")?.also { last -> runCatching { prefs(context).edit().putString(LAST, last.toJson().toString()).apply() } }
+        summary ?: return
+        val history = history(context) + summary
+        runCatching {
+            prefs(context).edit().putString(HISTORY, JSONArray(history.takeLast(KEEP).map {
+                JSONObject().put("at", it.at).put("engine", it.engine).put("region", it.region ?: JSONObject.NULL)
+                    .put("rttMs", it.rttMs ?: JSONObject.NULL).put("lossPct", it.lossPct ?: JSONObject.NULL)
+                    .put("mbps", it.mbps ?: JSONObject.NULL).put("capMbps", it.capMbps)
+            }).toString()).apply()
+        }
+    }
+
+    fun last(context: Context): Snapshot? =
+        live ?: runCatching { prefs(context).getString(LAST, null)?.let { Snapshot.fromJson(JSONObject(it)) } }.getOrNull()
+
+    fun history(context: Context): List<Summary> = runCatching {
+        val array = JSONArray(prefs(context).getString(HISTORY, "[]"))
+        (0 until array.length()).map { array.getJSONObject(it) }.map {
+            Summary(it.optLong("at"), it.optString("engine"), it.optString("region").takeIf { r -> r.isNotEmpty() && !it.isNull("region") },
+                it.intOrNull("rttMs"), it.doubleOrNull("lossPct"), it.doubleOrNull("mbps"), it.optInt("capMbps"))
+        }
+    }.getOrDefault(emptyList())
+
+    /**
+     * The bitrate cap for the next stream when quality is automatic and no manual limit is set: after a stream that
+     * lost more than 2 % of its packets, 80 % of the rate it averaged (at least 5 Mb/s); after a clean stream under a
+     * cap, a quarter more, until the cap no longer matters (above 40 Mb/s: no cap). 0 = no cap.
+     */
+    fun autoCap(history: List<Summary>): Int {
+        val last = history.lastOrNull() ?: return 0
+        val loss = last.lossPct ?: return last.capMbps
+        return when {
+            loss > 2.0 && last.mbps != null -> (last.mbps * 0.8).roundToInt().coerceAtLeast(5).let { if (last.capMbps > 0) minOf(it, last.capMbps) else it }
+            loss < 0.5 && last.capMbps > 0 -> (last.capMbps * 1.25).roundToInt().let { if (it > 40) 0 else it }
+            else -> last.capMbps
+        }
+    }
+
+    /** Excellent / good / fair / poor, from what was measured; null when nothing was. */
+    fun quality(s: Snapshot): String? {
+        val rtt = s.rttMs; val loss = s.lossPct; val jitter = s.jitterMs
+        if (rtt == null && loss == null && jitter == null) return null
+        fun within(v: Number?, limit: Double) = v == null || v.toDouble() <= limit
+        return when {
+            within(rtt, 40.0) && within(loss, 0.5) && within(jitter, 10.0) -> "excellent"
+            within(rtt, 80.0) && within(loss, 1.5) && within(jitter, 20.0) -> "good"
+            within(rtt, 120.0) && within(loss, 3.0) && within(jitter, 40.0) -> "fair"
+            else -> "poor"
+        }
+    }
+
+    private fun prefs(context: Context) = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private fun JSONObject.intOrNull(key: String) = if (!has(key) || isNull(key)) null else optInt(key)
+    private fun JSONObject.doubleOrNull(key: String) = if (!has(key) || isNull(key)) null else optDouble(key).takeIf { !it.isNaN() }
+}
