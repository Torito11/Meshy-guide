diff --git a/app/src/main/java/com/droiddeck/launcher/stores/xbox/XboxCloudNetwork.kt b/app/src/main/java/com/droiddeck/launcher/stores/xbox/XboxCloudNetwork.kt
new file mode 100644
index 0000000..3dc0d13
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/stores/xbox/XboxCloudNetwork.kt
@@ -0,0 +1,112 @@
+package com.droiddeck.launcher.stores.xbox
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.Socket
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import kotlin.math.roundToInt
+
+/**
+ * Round-trip time from this device to each region Microsoft offers this account (the login's own region list,
+ * nothing added): a TCP connection to the region's gateway, five times, DNS resolved beforehand so it is not
+ * counted. Another region than Microsoft's default is only chosen when it answers clearly faster, so a region far
+ * away is never picked for a millisecond or two. Results are kept 20 minutes.
+ */
+internal object XboxCloudNetwork {
+    private const val PREFS = "xbox_cloud_stats"
+    private const val PROBE = "probe"
+    private const val FRESH_MS = 20 * 60_000L
+    const val MIN_GAIN_MS = 15
+    const val MIN_GAIN_SHARE = 0.15
+
+    data class Probe(val region: String, val isDefault: Boolean, val medianMs: Int?, val spreadMs: Int?, val failures: Int)
+
+    fun probe(regions: List<XboxCloudSession.Region>, samples: Int = 5, timeoutMs: Int = 2000): List<Probe> {
+        if (regions.isEmpty()) return emptyList()
+        val pool = Executors.newFixedThreadPool(regions.size.coerceIn(1, 6))
+        try {
+            val futures = regions.map { region -> pool.submit<Probe> { probeOne(region, samples, timeoutMs) } }
+            return futures.mapIndexed { i, f ->
+                runCatching { f.get(samples.toLong() * timeoutMs + 5000, TimeUnit.MILLISECONDS) }
+                    .getOrElse { Probe(regions[i].name, regions[i].isDefault, null, null, samples) }
+            }
+        } finally {
+            pool.shutdownNow()
+        }
+    }
+
+    private fun probeOne(region: XboxCloudSession.Region, samples: Int, timeoutMs: Int): Probe {
+        val uri = runCatching { java.net.URI(region.baseUri) }.getOrNull()
+        val host = uri?.host ?: return Probe(region.name, region.isDefault, null, null, samples)
+        val port = uri.port.takeIf { it > 0 } ?: 443
+        val address = runCatching { InetAddress.getByName(host) }.getOrNull() ?: return Probe(region.name, region.isDefault, null, null, samples)
+        val times = ArrayList<Double>()
+        var failures = 0
+        repeat(samples) {
+            val socket = Socket()
+            val started = System.nanoTime()
+            try {
+                socket.connect(InetSocketAddress(address, port), timeoutMs)
+                times += (System.nanoTime() - started) / 1e6
+            } catch (_: Exception) {
+                failures++
+            } finally {
+                runCatching { socket.close() }
+            }
+        }
+        return summarize(region.name, region.isDefault, times, failures)
+    }
+
+    internal fun summarize(name: String, isDefault: Boolean, times: List<Double>, failures: Int): Probe {
+        if (times.isEmpty()) return Probe(name, isDefault, null, null, failures)
+        val sorted = times.sorted()
+        return Probe(name, isDefault, sorted[sorted.size / 2].roundToInt(), (sorted.last() - sorted.first()).roundToInt(), failures)
+    }
+
+    /** Microsoft's default region unless another answered at least [MIN_GAIN_MS] and [MIN_GAIN_SHARE] faster. */
+    fun choose(probes: List<Probe>): Probe? {
+        val default = probes.firstOrNull { it.isDefault } ?: probes.firstOrNull()
+        val usable = probes.filter { it.medianMs != null && it.failures <= 1 }
+        val best = usable.minByOrNull { it.medianMs!! } ?: return default
+        val baseline = default?.takeIf { it.medianMs != null && it.failures <= 1 }?.medianMs ?: return best
+        val gain = baseline - best.medianMs!!
+        return if (gain >= MIN_GAIN_MS && gain >= baseline * MIN_GAIN_SHARE) best else default
+    }
+
+    /** The region name to stream from with "lowest measured latency"; measures again after 20 minutes. */
+    fun bestRegion(context: Context, regions: List<XboxCloudSession.Region>, log: (String) -> Unit = {}): String? {
+        val names = regions.map { it.name }.toSet()
+        val cached = saved(context)?.takeIf { (at, probes) ->
+            System.currentTimeMillis() - at in 0 until FRESH_MS && probes.map { it.region }.toSet() == names
+        }?.second
+        val probes = cached ?: probe(regions).also { save(context, it) }
+        val chosen = choose(probes)
+        log("regions by latency: " + probes.joinToString { "${it.region}${if (it.isDefault) "*" else ""} ${it.medianMs?.let { ms -> "$ms ms" } ?: "no answer"}" } +
+            " -> ${chosen?.region ?: "Microsoft's default"}" + if (cached != null) " (measured earlier)" else "")
+        return chosen?.region
+    }
+
+    fun save(context: Context, probes: List<Probe>) {
+        val array = JSONArray(probes.map {
+            JSONObject().put("region", it.region).put("isDefault", it.isDefault).put("medianMs", it.medianMs ?: JSONObject.NULL)
+                .put("spreadMs", it.spreadMs ?: JSONObject.NULL).put("failures", it.failures)
+        })
+        runCatching {
+            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                .putString(PROBE, JSONObject().put("at", System.currentTimeMillis()).put("probes", array).toString()).apply()
+        }
+    }
+
+    fun saved(context: Context): Pair<Long, List<Probe>>? = runCatching {
+        val o = JSONObject(context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(PROBE, null) ?: return null)
+        val array = o.getJSONArray("probes")
+        o.getLong("at") to (0 until array.length()).map { array.getJSONObject(it) }.map {
+            Probe(it.getString("region"), it.optBoolean("isDefault"), if (it.isNull("medianMs")) null else it.optInt("medianMs"),
+                if (it.isNull("spreadMs")) null else it.optInt("spreadMs"), it.optInt("failures"))
+        }
+    }.getOrNull()
+}
