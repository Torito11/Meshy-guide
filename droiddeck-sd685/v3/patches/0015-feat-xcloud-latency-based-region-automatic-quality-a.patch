+package com.droiddeck.launcher.session
+
+import android.app.Application
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import org.robolectric.RuntimeEnvironment
+import java.io.File
+import java.util.Calendar
+import java.util.TimeZone
+
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner::class)
+@org.robolectric.annotation.Config(sdk = [33], application = Application::class)
+class DiagnosticsExtrasTest {
+    @get:Rule val tmp = TemporaryFolder()
+
+    private fun utc(h: Int, m: Int, s: Int) = Calendar.getInstance(TimeZone.getTimeZone("UTC")).apply {
+        set(2026, Calendar.NOVEMBER, 21, h, m, s); set(Calendar.MILLISECOND, 0)
+    }.timeInMillis
+
+    @Test fun aStartThatNeverReachedTheScreenSaysWhereItIs() {
+        val dir = tmp.newFolder("session")
+        File(dir, "events.jsonl").writeText("""{"t":${utc(10, 0, 0)},"event":"session.created"}""" + "\n")
+        File(dir, "session.log").writeText("== STEP 10:00:04.000 starting the session\n== STEP 10:00:30.000 starting the Steam client\n" +
+            "== STEP 10:05:30 steam is still starting: 300 s, client cpu 0%\n")
+        val report = DiagnosticsExtras.sessionReport(dir, now = utc(10, 10, 30))
+        assertTrue(report, "linux_ms=4000" in report)
+        assertTrue(report, "Steam started 600 s ago and has not reached the screen" in report)
+        assertTrue(report, "last step: steam is still starting" in report)
+    }
+
+    @Test fun theShareFolderGetsTimingsAndMemory() {
+        val dir = tmp.newFolder("shared")
+        DiagnosticsExtras.write(RuntimeEnvironment.getApplication(), dir)
+        assertTrue(File(dir, "timings.txt").readText().contains("start-up times"))
+        assertTrue(File(dir, "memory.txt").isFile)
+    }
+}
