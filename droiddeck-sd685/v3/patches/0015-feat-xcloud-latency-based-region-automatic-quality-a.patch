diff --git a/tools/tests/test_armv80_download_resume.py b/tools/tests/test_armv80_download_resume.py
new file mode 100644
index 0000000..098fba1
--- /dev/null
+++ b/tools/tests/test_armv80_download_resume.py
@@ -0,0 +1,81 @@
+"""droiddeck-proton-armv80 resumes an interrupted download (curl -C -) instead of starting over, reports the size
+on disk as it goes, and the result is byte-identical (the installer then checks its sha256)."""
+import hashlib
+import http.server
+import os
+from pathlib import Path
+import runpy
+import shutil
+import signal
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unittest
+
+BIN = Path(__file__).resolve().parents[1] / 'linuxfs/overlay/usr/local/bin'
+INSTALLER = BIN / 'droiddeck-proton-armv80'
+
+
+class Ranges(http.server.BaseHTTPRequestHandler):
+    payload = b''
+    served = []
+
+    def log_message(self, *args):
+        pass
+
+    def do_GET(self):
+        start = 0
+        header = self.headers.get('Range')
+        if header and header.startswith('bytes='):
+            start = int(header[6:].split('-')[0])
+            self.send_response(206)
+            self.send_header('Content-Range', 'bytes %d-%d/%d' % (start, len(self.payload) - 1, len(self.payload)))
+        else:
+            self.send_response(200)
+        self.send_header('Content-Length', str(len(self.payload) - start))
+        self.end_headers()
+        Ranges.served.append(start)
+        for offset in range(start, len(self.payload), 128 * 1024):
+            try:
+                self.wfile.write(self.payload[offset:offset + 128 * 1024])
+                self.wfile.flush()
+            except (BrokenPipeError, ConnectionResetError):
+                return
+            time.sleep(0.05)
+
+
+@unittest.skipUnless(shutil.which('curl'), 'curl is needed')
+class DownloadResumeTest(unittest.TestCase):
+    def test_an_interrupted_download_resumes(self):
+        Ranges.payload = os.urandom(3 * 1024 * 1024)
+        Ranges.served = []
+        server = http.server.ThreadingHTTPServer(('127.0.0.1', 0), Ranges)
+        threading.Thread(target=server.serve_forever, daemon=True).start()
+        url = 'http://127.0.0.1:%d/proton.tar.gz' % server.server_address[1]
+        env = {k: v for k, v in os.environ.items() if k.lower() not in ('http_proxy', 'https_proxy', 'all_proxy')}
+        try:
+            with tempfile.TemporaryDirectory() as tmp:
+                tarball = os.path.join(tmp, 'proton.tar.gz')
+                code = ('import runpy,sys; g=runpy.run_path(%r); sys.exit(g["download"](%r, %r))' % (str(INSTALLER), url, tarball))
+                first = subprocess.Popen([sys.executable, '-c', code], env=env, start_new_session=True,
+                                         stdout=subprocess.PIPE, text=True)
+                time.sleep(0.8)
+                os.killpg(first.pid, signal.SIGKILL)
+                first.wait()
+                partial = os.path.getsize(tarball)
+                self.assertTrue(0 < partial < len(Ranges.payload), partial)
+                second = subprocess.run([sys.executable, '-c', code], env=env, capture_output=True, text=True, timeout=120)
+                self.assertEqual(second.returncode, 0, second.stderr)
+                data = Path(tarball).read_bytes()
+                self.assertEqual(hashlib.sha256(data).hexdigest(), hashlib.sha256(Ranges.payload).hexdigest())
+                self.assertEqual(Ranges.served[0], 0)
+                self.assertGreater(Ranges.served[-1], 0, 'the second request asked for the rest only')
+                self.assertRegex(second.stdout, r'== STEP \d\d:\d\d:\d\d downloading DroidDeck-Proton 11-12.8 for ARMv8.0: \d+ of 626 MB')
+        finally:
+            server.shutdown()
+
+
+if __name__ == '__main__':
+    unittest.main()
