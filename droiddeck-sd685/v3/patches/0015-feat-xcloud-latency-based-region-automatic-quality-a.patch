diff --git a/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt b/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt
new file mode 100644
index 0000000..3cbcd5d
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt
@@ -0,0 +1,86 @@
+package com.droiddeck.launcher.session
+
+import android.app.ActivityManager
+import android.content.Context
+import android.os.Build
+import android.os.PowerManager
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import org.json.JSONObject
+import java.io.File
+import java.io.RandomAccessFile
+
+/**
+ * Files the shared logs ZIP gets in addition to the session folder, written just before it is packed (the ZIP's own
+ * redaction then applies to them like to every other file): start-up times (also for a start that never reached the
+ * screen), memory and thermal state, and the x86-64 client launcher's own log with its renderer choice.
+ */
+object DiagnosticsExtras {
+    private const val TAIL = 2L * 1024 * 1024
+
+    fun write(context: Context, dir: File) {
+        runCatching { File(dir, "timings.txt").writeText(sessionReport(dir) + "\n" + StartupTimes.describe(context)) }
+        runCatching { File(dir, "memory.txt").writeText(memory(context)) }
+        runCatching {
+            val home = File(LinuxRuntime.rootDir(context), "root/.droiddeck-x64")
+            val out = File(dir, "steam-x64").apply { mkdirs() }
+            tail(File(home, "steam-x64.log"), File(out, "steam-x64.log"))
+            for (name in listOf(".droiddeck-cef-software", ".droiddeck-client-ok")) {
+                File(home, name).takeIf { it.isFile }?.copyTo(File(out, name.trimStart('.') + ".txt"), overwrite = true)
+            }
+            if (out.list().isNullOrEmpty()) out.delete()
+        }
+    }
+
+    /** This session's phases so far, with what it is still waiting for. */
+    internal fun sessionReport(dir: File, now: Long = System.currentTimeMillis()): String {
+        val events = File(dir, "events.jsonl").takeIf { it.isFile }?.readLines()
+            ?.mapNotNull { runCatching { JSONObject(it) }.getOrNull() }.orEmpty()
+        val created = events.firstOrNull { it.optString("event") == "session.created" }?.optLong("t") ?: return "This session: no events.\n"
+        val log = File(dir, "session.log").takeIf { it.isFile }?.let { readTail(it, 512 * 1024) }.orEmpty()
+        val steps = StartupTimes.steps(log, created)
+        val phases = StartupTimes.sessionPhases(events, steps)
+        val sb = StringBuilder("This session (ms): ")
+        sb.append(phases.entries.joinToString { "${it.key}=${it.value}" }.ifEmpty { "nothing measured yet" })
+        if ("total_ms" !in phases) {
+            val steam = steps.lastOrNull { it.text.startsWith("starting the Steam client") }
+            sb.append(if (steam != null) "; Steam started ${(now - steam.atMs) / 1000} s ago and has not reached the screen"
+                else "; ${(now - created) / 1000} s since Play, Steam not started yet")
+            steps.lastOrNull()?.let { sb.append("; last step: ").append(it.text.take(200)) }
+        }
+        if (StartupTimes.firstStart(steps)) sb.append(" (first start: something was downloaded or installed)")
+        return sb.append('\n').toString()
+    }
+
+    internal fun memory(context: Context): String {
+        val sb = StringBuilder()
+        val am = context.getSystemService(ActivityManager::class.java)
+        if (am != null) {
+            val info = ActivityManager.MemoryInfo().also { am.getMemoryInfo(it) }
+            sb.append("Android: total ${info.totalMem shr 20} MB, available ${info.availMem shr 20} MB, low-memory threshold ")
+                .append("${info.threshold shr 20} MB, low memory now: ${info.lowMemory}\n")
+        }
+        if (Build.VERSION.SDK_INT >= 29) runCatching {
+            val pm = context.getSystemService(PowerManager::class.java)
+            sb.append("Thermal status: ${com.droiddeck.launcher.core.DeviceReport.thermalStatusName(pm.currentThermalStatus)}\n")
+        }
+        runCatching {
+            File("/proc/meminfo").readLines().filter { line ->
+                listOf("MemTotal", "MemFree", "MemAvailable", "Cached", "SwapTotal", "SwapFree", "Shmem").any { line.startsWith("$it:") }
+            }.forEach { sb.append(it).append('\n') }
+        }
+        return sb.toString()
+    }
+
+    private fun tail(src: File, dst: File) {
+        if (!src.isFile) return
+        dst.writeText(readTail(src, TAIL))
+    }
+
+    private fun readTail(file: File, bytes: Long): String = RandomAccessFile(file, "r").use { f ->
+        val start = (f.length() - bytes).coerceAtLeast(0)
+        f.seek(start)
+        val buf = ByteArray((f.length() - start).toInt())
+        f.readFully(buf)
+        String(buf, Charsets.UTF_8)
+    }
+}
