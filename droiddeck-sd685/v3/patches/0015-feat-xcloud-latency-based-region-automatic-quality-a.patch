+package com.droiddeck.launcher.stores.xbox
+
+import android.app.Application
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.robolectric.RuntimeEnvironment
+
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner::class)
+@org.robolectric.annotation.Config(sdk = [33], application = Application::class)
+class XboxCloudStatsTest {
+    private fun report(atMs: Double, bytes: Long, lost: Int, received: Int, decodeS: Double, decoded: Int) = listOf(
+        XboxCloudStats.Entry("codec", "C1", atMs, mapOf("mimeType" to "video/H264")),
+        XboxCloudStats.Entry("candidate-pair", "P1", atMs, mapOf("state" to "succeeded", "nominated" to true, "currentRoundTripTime" to 0.052)),
+        XboxCloudStats.Entry("inbound-rtp", "V1", atMs, mapOf("kind" to "video", "frameWidth" to 1920, "frameHeight" to 1080,
+            "framesPerSecond" to 59.8, "codecId" to "C1", "bytesReceived" to bytes, "packetsLost" to lost, "packetsReceived" to received,
+            "jitter" to 0.004, "totalDecodeTime" to decodeS, "framesDecoded" to decoded, "framesDropped" to 3L)),
+    )
+
+    @Test fun ratesComeFromTheChangeBetweenReports() {
+        val reader = XboxCloudStats.Reader("native")
+        val first = reader.read(report(1000.0, 1_000_000, 0, 1000, 1.0, 100), "EastUS", "streaming", 0)
+        assertNull(first.mbps)
+        assertEquals(1920, first.width); assertEquals(60, first.fps); assertEquals("H264", first.codec)
+        assertEquals(52, first.rttMs); assertEquals(4, first.jitterMs)
+        val second = reader.read(report(3000.0, 6_000_000, 10, 1990, 1.6, 220), "EastUS", "streaming", 0)
+        assertEquals(20.0, second.mbps!!, 0.01)          // 5 MB in 2 s
+        assertEquals(1.0, second.lossPct!!, 0.01)         // 10 lost of 1000 more
+        assertEquals(5.0, second.decodeMs!!, 0.01)        // 0.6 s for 120 frames
+        val summary = reader.summary("EastUS", 0)!!
+        assertEquals(52, summary.rttMs); assertEquals(1.0, summary.lossPct!!, 0.01); assertEquals(20.0, summary.mbps!!, 0.01)
+    }
+
+    @Test fun nothingReportedStaysUnknown() {
+        val s = XboxCloudStats.Reader("web").read(emptyList(), null, "connecting", 0)
+        assertNull(s.width); assertNull(s.rttMs); assertNull(s.codec)
+        assertNull(XboxCloudStats.quality(s))
+    }
+
+    @Test fun automaticQualityLowersAfterLossAndRisesAfterCleanStreams() {
+        fun summary(loss: Double?, mbps: Double?, cap: Int) = XboxCloudStats.Summary(0, "native", "EastUS", 60, loss, mbps, cap)
+        assertEquals(0, XboxCloudStats.autoCap(emptyList()))
+        assertEquals(16, XboxCloudStats.autoCap(listOf(summary(3.5, 20.0, 0))))
+        assertEquals(5, XboxCloudStats.autoCap(listOf(summary(9.0, 4.0, 0))))
+        assertEquals(12, XboxCloudStats.autoCap(listOf(summary(3.0, 20.0, 12))))   // never above the cap that still lost packets
+        assertEquals(20, XboxCloudStats.autoCap(listOf(summary(0.2, 15.0, 16))))
+        assertEquals(0, XboxCloudStats.autoCap(listOf(summary(0.1, 30.0, 35))))     // past 40 Mb/s the cap goes away
+        assertEquals(16, XboxCloudStats.autoCap(listOf(summary(1.0, 15.0, 16))))   // in between: kept
+        assertEquals(16, XboxCloudStats.autoCap(listOf(summary(null, null, 16))))
+    }
+
+    @Test fun connectionQualityFollowsTheMeasuredValues() {
+        fun q(rtt: Int?, loss: Double?, jitter: Int?) = XboxCloudStats.quality(XboxCloudStats.Snapshot(0, "native", null, "streaming",
+            rttMs = rtt, lossPct = loss, jitterMs = jitter))
+        assertEquals("excellent", q(30, 0.1, 5)); assertEquals("good", q(70, 1.0, 15))
+        assertEquals("fair", q(110, 2.5, 30)); assertEquals("poor", q(180, 5.0, 60))
+    }
+
+    @Test fun theWebPlayersReportIsRead() {
+        val json = """[{"type":"inbound-rtp","id":"V1","timestamp":5000.5,"members":{"kind":"video","frameWidth":1280,"frameHeight":720,"framesPerSecond":60}},
+            {"type":"candidate-pair","id":"P","timestamp":5000.5,"members":{"state":"succeeded","nominated":true,"currentRoundTripTime":0.08}}]"""
+        val s = XboxCloudStats.Reader("web").read(XboxCloudStats.entries(json), "SouthCentralUS", "streaming", 8)
+        assertEquals(1280, s.width); assertEquals(80, s.rttMs); assertEquals(8, s.capMbps)
+    }
+
+    @Test fun theLastStreamAndItsHistoryAreKept() {
+        val app = RuntimeEnvironment.getApplication()
+        val reader = XboxCloudStats.Reader("native")
+        reader.read(report(1000.0, 1_000_000, 0, 1000, 1.0, 100), "EastUS", "streaming", 0)
+        XboxCloudStats.update(app, reader.read(report(3000.0, 6_000_000, 10, 1990, 1.6, 220), "EastUS", "streaming", 0))
+        XboxCloudStats.ended(app, reader.summary("EastUS", 0))
+        assertEquals("ended", XboxCloudStats.last(app)!!.state)
+        assertEquals("EastUS", XboxCloudStats.history(app).last().region)
+    }
+}
+
+class XboxCloudNetworkTest {
+    private fun p(name: String, ms: Int?, default: Boolean = false, failures: Int = 0) = XboxCloudNetwork.Probe(name, default, ms, 3, failures)
+
+    @Test fun microsoftsDefaultIsKeptWithoutAClearGain() {
+        assertEquals("EastUS", XboxCloudNetwork.choose(listOf(p("EastUS", 80, true), p("SouthCentralUS", 70)))?.region)   // 10 ms: not enough
+        assertEquals("SouthCentralUS", XboxCloudNetwork.choose(listOf(p("EastUS", 100, true), p("SouthCentralUS", 70)))?.region)
+        assertEquals("EastUS", XboxCloudNetwork.choose(listOf(p("EastUS", 300, true), p("WestUS", 284)))?.region)          // 16 ms is 5 %
+    }
+
+    @Test fun unreachableRegionsAreNotChosen() {
+        assertEquals("EastUS", XboxCloudNetwork.choose(listOf(p("EastUS", 90, true), p("BrazilSouth", 20, failures = 3)))?.region)
+        assertEquals("WestUS", XboxCloudNetwork.choose(listOf(p("EastUS", null, true, failures = 5), p("WestUS", 120)))?.region)
+        assertNull(XboxCloudNetwork.choose(emptyList()))
+    }
+
+    @Test fun samplesBecomeAMedianAndASpread() {
+        val probe = XboxCloudNetwork.summarize("EastUS", true, listOf(71.2, 64.9, 90.0, 66.0, 65.5), 0)
+        assertEquals(66, probe.medianMs); assertEquals(25, probe.spreadMs)
+        assertNull(XboxCloudNetwork.summarize("X", false, emptyList(), 5).medianMs)
+    }
+}
