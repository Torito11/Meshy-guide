diff --git a/app/src/main/java/com/droiddeck/launcher/session/StartupTimes.kt b/app/src/main/java/com/droiddeck/launcher/session/StartupTimes.kt
new file mode 100644
index 0000000..0ece102
--- /dev/null
+++ b/app/src/main/java/com/droiddeck/launcher/session/StartupTimes.kt
@@ -0,0 +1,201 @@
+package com.droiddeck.launcher.session
+
+import android.content.Context
+import android.util.Log
+import com.droiddeck.launcher.wayland.WaylandCompositor
+import org.json.JSONObject
+import java.io.File
+import java.util.Calendar
+import java.util.TimeZone
+
+/**
+ * Start-up times, measured from what a session already records: events.jsonl (the app's own events, wall-clock
+ * milliseconds) and the session script's "== STEP hh:mm:ss[.mmm]" lines (UTC). Records go to
+ * files/startup-times.jsonl (the last [KEEP]) so a start can be compared with earlier ones, and each session's
+ * phases to timings.txt in its log folder, so the diagnostics ZIP carries them.
+ *
+ * Phases of a Steam session: linux (Play pressed → the Linux session script running), fex (FEX, the x86 rootfs
+ * and the x86-64 client checked, on a CPU that needs them), steam (the client started → its first frame on
+ * screen), total. Games: launch (Proton starts the game, droiddeck-game-env) → its window focused by gamescope
+ * (first image) → 3 s in a row at 20 fps or more ("smooth"; a loading screen can count, so this is not "playable").
+ * App: process start → first frame of the launcher (cold starts only).
+ */
+object StartupTimes {
+    const val FILE = "startup-times.jsonl"
+    const val GAME_LAUNCH = "game-launch"
+    private const val TAG = "StartupTimes"
+    private const val KEEP = 80
+    private val lock = Any()
+    @Volatile private var app: Context? = null
+    @Volatile private var sessionRoot: File? = null
+    @Volatile private var focused: String? = null
+    @Volatile private var sampler: Thread? = null
+    @Volatile var coldStartPending = true
+
+    data class Step(val atMs: Long, val text: String)
+
+    fun attach(context: Context, root: File) {
+        app = context.applicationContext
+        sessionRoot = root
+        focused = null
+    }
+
+    fun record(context: Context, kind: String, values: Map<String, Any?>) {
+        val line = JSONObject().put("t", System.currentTimeMillis()).put("kind", kind)
+            .put("version", com.droiddeck.launcher.BuildConfig.VERSION_NAME)
+        values.forEach { (k, v) -> line.put(k, v ?: JSONObject.NULL) }
+        synchronized(lock) {
+            runCatching {
+                val file = File(context.filesDir, FILE)
+                val kept = (if (file.isFile) file.readLines() else emptyList()).takeLast(KEEP - 1)
+                file.writeText((kept + line.toString()).joinToString("\n") + "\n")
+            }.onFailure { Log.w(TAG, "could not save $kind times", it) }
+        }
+        Log.i(TAG, "$kind: $values")
+    }
+
+    fun recent(context: Context): List<JSONObject> = synchronized(lock) {
+        runCatching { File(context.filesDir, FILE).readLines().mapNotNull { runCatching { JSONObject(it) }.getOrNull() } }
+            .getOrDefault(emptyList())
+    }
+
+    /** UTC times of day in a session log, placed on the day the session started; rolls over midnight. */
+    internal fun steps(log: String, sessionStartMs: Long): List<Step> {
+        val day = Calendar.getInstance(TimeZone.getTimeZone("UTC")).apply {
+            timeInMillis = sessionStartMs
+            set(Calendar.HOUR_OF_DAY, 0); set(Calendar.MINUTE, 0); set(Calendar.SECOND, 0); set(Calendar.MILLISECOND, 0)
+        }.timeInMillis
+        var offset = 0L
+        var last = -1L
+        return log.lineSequence().mapNotNull { line ->
+            val m = STEP.find(line) ?: return@mapNotNull null
+            var at = day + offset + m.groupValues[1].toLong() * 3_600_000 + m.groupValues[2].toLong() * 60_000 +
+                m.groupValues[3].toLong() * 1000 + (m.groupValues[4].takeIf { it.isNotEmpty() }?.padEnd(3, '0')?.take(3)?.toLong() ?: 0)
+            if (last >= 0 && at < last - 12 * 3_600_000L) { offset += 86_400_000L; at += 86_400_000L }
+            last = at
+            Step(at, m.groupValues[5])
+        }.toList()
+    }
+
+    internal fun sessionPhases(events: List<JSONObject>, steps: List<Step>): Map<String, Long> {
+        fun event(name: String) = events.firstOrNull { it.optString("event") == name }?.optLong("t")?.takeIf { it > 0 }
+        val created = event("session.created") ?: return emptyMap()
+        val frame = event("frame.first")
+        val linux = steps.firstOrNull()?.atMs ?: event("guest.started")
+        val x64Start = steps.firstOrNull { it.text.startsWith("checking the x86-64 Steam client") }?.atMs
+        val x64Ready = steps.firstOrNull { it.text.startsWith("x86-64 Steam client ready") }?.atMs
+        val steam = steps.lastOrNull { it.text.startsWith("starting the Steam client") && (frame == null || it.atMs <= frame) }?.atMs
+        val out = linkedMapOf<String, Long>()
+        linux?.let { out["linux_ms"] = (it - created).coerceAtLeast(0) }
+        if (x64Start != null && x64Ready != null && x64Ready >= x64Start) out["fex_ms"] = x64Ready - x64Start
+        if (steam != null && frame != null) out["steam_ms"] = (frame - steam).coerceAtLeast(0)
+        if (frame != null) out["total_ms"] = (frame - created).coerceAtLeast(0)
+        return out
+    }
+
+    /** A start that downloaded, unpacked or installed something: compared apart from the ordinary ones. */
+    internal fun firstStart(steps: List<Step>): Boolean = steps.any { s ->
+        val t = s.text.lowercase()
+        t.startsWith("download") || t.startsWith("unpacking") || t.startsWith("installing") || t.startsWith("repairing")
+    }
+
+    /** Called when the session's first frame is on screen. */
+    fun sessionShown(dir: File?) {
+        val context = app ?: return
+        dir ?: return
+        Thread({
+            runCatching {
+                val events = File(dir, "events.jsonl").takeIf { it.isFile }?.readLines()
+                    ?.mapNotNull { runCatching { JSONObject(it) }.getOrNull() }.orEmpty()
+                val created = events.firstOrNull { it.optString("event") == "session.created" }?.optLong("t") ?: return@runCatching
+                val log = File(dir, "session.log").takeIf { it.isFile }?.let { tail(it, 512 * 1024) }.orEmpty()
+                val steps = steps(log, created)
+                val phases = sessionPhases(events, steps)
+                if (phases.isEmpty()) return@runCatching
+                val first = firstStart(steps)
+                record(context, "session", phases + mapOf("mode" to SessionState.mode, "first" to first))
+                File(dir, "timings.txt").writeText(describe(context))
+            }.onFailure { Log.w(TAG, "session times", it) }
+        }, "startup-times").start()
+    }
+
+    /** gamescope's focused app changed (AgentGuest). A game coming into focus after droiddeck-game-env marked its launch
+     *  gives the launch → first image time, then the launch → smooth time. */
+    fun focusChanged(focusedApp: String?) {
+        val context = app ?: return
+        val now = System.currentTimeMillis()
+        val game = focusedApp?.trim()?.takeIf { it.isNotEmpty() && it.all(Char::isDigit) && it != "0" && it != STEAM_APP }
+        val previous = focused
+        focused = focusedApp?.trim()
+        if (game == null || game == previous) return
+        val launch = readLaunch() ?: return
+        if (now - launch.first !in 0..15 * 60_000L || (launch.second != "0" && launch.second != game)) return
+        runCatching { File(sessionRoot, GAME_LAUNCH).delete() }
+        val firstImage = now - launch.first
+        sampler?.interrupt()
+        sampler = Thread({
+            var smoothAt: Long? = null
+            try {
+                var last = WaylandCompositor.gameFrameCount()
+                var run = 0
+                val end = System.currentTimeMillis() + 10 * 60_000L
+                while (System.currentTimeMillis() < end && focused == game) {
+                    Thread.sleep(1000)
+                    val count = WaylandCompositor.gameFrameCount()
+                    run = if (count - last >= 20) run + 1 else 0
+                    last = count
+                    if (run >= 3) { smoothAt = System.currentTimeMillis() - 3000; break }
+                }
+            } catch (_: InterruptedException) {
+            }
+            record(context, "game", mapOf("app" to game, "first_image_ms" to firstImage,
+                "smooth_ms" to smoothAt?.let { it - launch.first }))
+        }, "game-start-times").apply { isDaemon = true; start() }
+    }
+
+    private fun readLaunch(): Pair<Long, String>? {
+        val file = File(sessionRoot ?: return null, GAME_LAUNCH)
+        val parts = runCatching { file.readText().trim().split(Regex("\\s+")) }.getOrNull() ?: return null
+        val at = parts.getOrNull(0)?.toLongOrNull() ?: return null
+        return at to (parts.getOrNull(1) ?: "0")
+    }
+
+    private fun tail(file: File, bytes: Int): String = java.io.RandomAccessFile(file, "r").use { f ->
+        val start = (f.length() - bytes).coerceAtLeast(0)
+        f.seek(start)
+        val buf = ByteArray((f.length() - start).toInt())
+        f.readFully(buf)
+        String(buf, Charsets.UTF_8)
+    }
+
+    /** A plain-text table of the recorded times: last value, and median of the last five, per kind and phase;
+     *  first starts (downloads, installs) apart. */
+    fun describe(context: Context): String {
+        val records = recent(context)
+        val sb = StringBuilder("DroidDeck start-up times (ms). Median of the last 5, then the last value.\n")
+        fun line(title: String, rows: List<JSONObject>, key: String) {
+            val values = rows.mapNotNull { r -> r.optLong(key, -1).takeIf { it >= 0 } }
+            if (values.isEmpty()) return
+            val last5 = values.takeLast(5).sorted()
+            sb.append(String.format(java.util.Locale.ROOT, "%-42s median %7d  last %7d  (%d)\n", title, last5[last5.size / 2], values.last(), values.size))
+        }
+        val app = records.filter { it.optString("kind") == "app" }
+        line("App opening (cold start)", app, "app_open_ms")
+        for ((label, first) in listOf("Later starts" to false, "First starts (downloads/installs)" to true)) {
+            val rows = records.filter { it.optString("kind") == "session" && it.optBoolean("first") == first }
+            if (rows.isEmpty()) continue
+            sb.append(label).append(":\n")
+            line("  Linux (Play → session script)", rows, "linux_ms")
+            line("  FEX + x86-64 client checks", rows, "fex_ms")
+            line("  Steam (client start → first frame)", rows, "steam_ms")
+            line("  Total (Play → Steam on screen)", rows, "total_ms")
+        }
+        val games = records.filter { it.optString("kind") == "game" }
+        line("Game: launch → first image", games, "first_image_ms")
+        line("Game: launch → smooth (20+ fps for 3 s)", games, "smooth_ms")
+        return sb.toString()
+    }
+
+    private const val STEAM_APP = "769"
+    private val STEP = Regex("""^== STEP (\d{2}):(\d{2}):(\d{2})(?:\.(\d{1,3}))? (.*)$""")
+}
