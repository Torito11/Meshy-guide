@@ -1203,11 +1203,28 @@ def exec_proton(command, env):
     os.execvpe(command[0], command, env)
 
 
+def mark_launch(env, app_id):
+    """The app times launch -> first image -> smooth from this (session/StartupTimes.kt)."""
+    folder = env.get("BL_LAUNCH_DIR", "")
+    if not folder or not os.path.isdir(folder):
+        return
+    try:
+        import time
+        tmp = os.path.join(folder, ".game-launch.tmp")
+        with open(tmp, "w", encoding="utf-8") as out:
+            out.write("%d %s\n" % (int(time.time() * 1000), app_id or "0"))
+        os.replace(tmp, os.path.join(folder, "game-launch"))
+    except OSError:
+        pass
+
+
 def main():
     command = sys.argv[1:]
     if not command:
         return 2
     env = game_gpu(os.environ.copy())
+    if len(command) > 1 and command[1] == "waitforexitandrun":
+        mark_launch(env, game_id(env))
     mic_enabled = env.get("BL_MIC_ENABLED")
     debug_dir = env.get("BL_DEBUG_DIR", "")
     prefix_path = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
