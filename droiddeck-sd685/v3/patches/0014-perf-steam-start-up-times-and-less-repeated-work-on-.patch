@@ -0,0 +1,32 @@
+"""droiddeck-game-env marks each game launch in the session's launch folder for the app's start-up times."""
+from pathlib import Path
+import runpy
+import tempfile
+import time
+import unittest
+
+BIN = Path(__file__).resolve().parents[1] / 'linuxfs/overlay/usr/local/bin'
+GAME_ENV = runpy.run_path(str(BIN / 'droiddeck-game-env'))
+
+
+class GameLaunchMarkTest(unittest.TestCase):
+    def test_launch_time_and_game_are_written_atomically(self):
+        with tempfile.TemporaryDirectory() as folder:
+            before = int(time.time() * 1000)
+            GAME_ENV['mark_launch']({'BL_LAUNCH_DIR': folder}, '1091500')
+            at, game = (Path(folder) / 'game-launch').read_text().split()
+            self.assertEqual(game, '1091500')
+            self.assertTrue(before <= int(at) <= int(time.time() * 1000))
+            self.assertFalse((Path(folder) / '.game-launch.tmp').exists())
+
+    def test_no_launch_folder_writes_nothing(self):
+        GAME_ENV['mark_launch']({}, '10')
+        GAME_ENV['mark_launch']({'BL_LAUNCH_DIR': '/nonexistent/droiddeck'}, '10')
+
+    def test_only_the_game_itself_is_marked(self):
+        source = (BIN / 'droiddeck-game-env').read_text()
+        self.assertIn('if len(command) > 1 and command[1] == "waitforexitandrun":\n        mark_launch(env, game_id(env))', source)
+
+
+if __name__ == '__main__':
+    unittest.main()
