@@ -0,0 +1,66 @@
+package com.droiddeck.launcher.session
+
+import android.app.Application
+import org.json.JSONObject
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.robolectric.RuntimeEnvironment
+import java.util.Calendar
+import java.util.TimeZone
+
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner::class)
+@org.robolectric.annotation.Config(sdk = [33], application = Application::class)
+class StartupTimesTest {
+    private fun utc(h: Int, m: Int, s: Int, ms: Int = 0) = Calendar.getInstance(TimeZone.getTimeZone("UTC")).apply {
+        set(2026, Calendar.NOVEMBER, 21, h, m, s); set(Calendar.MILLISECOND, ms)
+    }.timeInMillis
+
+    private val log = """
+        == STEP 14:00:03.250 starting the session
+        some output
+        == STEP 14:00:10.000 checking the x86-64 Steam client (FEX, experimental; the first run downloads ~2 GB)
+        == STEP 14:00:41 FEX, rootfs and client ready
+        == STEP 14:00:42.500 x86-64 Steam client ready
+        == STEP 14:00:43.000 starting the Steam client
+        == STEP 14:01:13 steam is still starting: 30 s, client cpu 140%
+    """.trimIndent()
+
+    @Test fun phasesComeFromTheEventsAndTheScriptSteps() {
+        val created = utc(14, 0, 0)
+        val events = listOf(
+            JSONObject().put("event", "session.created").put("t", created),
+            JSONObject().put("event", "guest.started").put("t", utc(14, 0, 2)),
+            JSONObject().put("event", "frame.first").put("t", utc(14, 2, 13)),
+        )
+        val phases = StartupTimes.sessionPhases(events, StartupTimes.steps(log, created))
+        assertEquals(3_250L, phases["linux_ms"])
+        assertEquals(32_500L, phases["fex_ms"])
+        assertEquals(90_000L, phases["steam_ms"])
+        assertEquals(133_000L, phases["total_ms"])
+    }
+
+    @Test fun stepsAfterMidnightStayInOrder() {
+        val steps = StartupTimes.steps("== STEP 23:59:59.900 a\n== STEP 00:00:00.100 b", utc(23, 59, 50))
+        assertEquals(200L, steps[1].atMs - steps[0].atMs)
+    }
+
+    @Test fun downloadsMakeAFirstStart() {
+        val created = utc(14, 0, 0)
+        assertFalse(StartupTimes.firstStart(StartupTimes.steps(log, created)))
+        assertTrue(StartupTimes.firstStart(StartupTimes.steps("== STEP 14:00:01 downloading the x86-64 Steam client (x)", created)))
+    }
+
+    @Test fun recordsAreKeptAndSummarised() {
+        val app = RuntimeEnvironment.getApplication()
+        StartupTimes.record(app, "app", mapOf("app_open_ms" to 900L))
+        StartupTimes.record(app, "session", mapOf("linux_ms" to 3000L, "steam_ms" to 60000L, "total_ms" to 70000L, "first" to false))
+        StartupTimes.record(app, "game", mapOf("first_image_ms" to 25000L, "smooth_ms" to 41000L))
+        val text = StartupTimes.describe(app)
+        assertTrue(text, "App opening (cold start)" in text && "900" in text)
+        assertTrue(text, "Steam (client start → first frame)" in text && "60000" in text)
+        assertTrue(text, "Game: launch → first image" in text && "25000" in text)
+        assertEquals(3, StartupTimes.recent(app).size)
+    }
+}
