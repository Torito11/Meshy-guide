diff --git a/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64 b/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
index 361f962..95ea556 100755
--- a/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
+++ b/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
@@ -882,7 +882,102 @@ x64_arm_webhelper_cpu_supported() {
 # Valve's arm64 client, web helper and every arm64 Proton build need the same LSE atomics.
 x64_arm64_builds_supported() { x64_arm_webhelper_cpu_supported; }
 
+x64_client_build() {
+  local chan
+  chan=$(cat "$STEAM_X64/package/beta" 2>/dev/null || echo "$X64_CHANNEL")
+  awk -F'"' '$2 == "version" { print $4; exit }' "$STEAM_X64/package/steam_client_${chan}_steamrt64.manifest" 2>/dev/null
+}
+
+# CPU time (clock ticks) of the client and its web helpers, all FEX processes.
+x64_client_ticks() {
+  local p stat rest total=0
+  for p in $(pgrep -f 'steamrt64/steam( |$)|/steamwebhelper( |$)' 2>/dev/null); do
+    read -r stat < "/proc/$p/stat" 2>/dev/null || continue
+    rest=${stat##*) }
+    set -- $rest
+    total=$((total + ${12:-0} + ${13:-0}))
+  done
+  echo "$total"
+}
+
+# The bootstrapper writes this log while it downloads, unpacks or verifies the client.
+x64_bootstrap_active() {
+  local f=$STEAM_X64/logs/bootstrap_log.txt
+  [ -f "$f" ] && [ $(( $(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0) )) -lt 30 ]
+}
+
+x64_stop_client() {
+  kill -TERM "$1" 2>/dev/null
+  for _ in $(seq 1 20); do kill -0 "$1" 2>/dev/null || break; sleep 1; done
+  kill -KILL "$1" 2>/dev/null
+  pkill -KILL -f '/steamwebhelper( |$)' 2>/dev/null
+  return 0
+}
+
+# Until the app reports the first frame on screen ($REAL_HOME/.bl-first-frame), say what the client is doing and
+# recover from what can be recognised. The menu renderer (an x86 Chromium under FEX, drawing through FEX's GL
+# thunks) giving up on the GPU leaves the screen empty for good: the client is restarted once with software
+# rendering, remembered for this client build. A client that has stopped doing anything is restarted once the same
+# way when it was on the GPU renderer, and only reported otherwise. The software choice persists, so nothing here
+# can restart the client more than once per session.
+x64_first_frame_watch() {
+  local client=$1 mode=$2 frame=$REAL_HOME/.bl-first-frame soft_file=$X64_HOME/.droiddeck-cef-software
+  local log=$STEAM_X64/logs/console-linux.txt from t0=$SECONDS last=-1 idle=0 pct=0 ticks elapsed exits hz said=0 avail lib busy
+  local tick=${BL_X64_WATCH_TICK:-5} stall=${BL_X64_WATCH_STALL:-180} least=${BL_X64_WATCH_MIN:-300} every=${BL_X64_WATCH_SAY:-30}
+  hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
+  from=$(( $(wc -l 2>/dev/null < "$log" || echo 0) + 1 ))
+  while kill -0 "$client" 2>/dev/null; do
+    sleep "$tick"
+    [ -e "$frame" ] && return 0
+    elapsed=$((SECONDS - t0))
+    exits=$(tail -n +"$from" "$log" 2>/dev/null | grep -c "GPU process exited unexpectedly")
+    if [ "$mode" = gpu ] && { tail -n +"$from" "$log" 2>/dev/null | grep -q "GPU process isn't usable" || [ "${exits:-0}" -ge 3 ]; }; then
+      printf '%s\n%s\n' "$(x64_client_build)" "the GPU renderer failed ($exits GPU process exits) on $(date -u +%F)" > "$soft_file"
+      : > "$REAL_HOME/.bl-restart-software"
+      step "steam's menus failed on the GPU ($exits GPU process exits): restarting Steam with software rendering"
+      x64_stop_client "$client"
+      return 0
+    fi
+    lib=$(tail -n +"$from" "$log" 2>/dev/null | grep -o -m1 "error while loading shared libraries: [^:]*" | sed 's/.*: //')
+    ticks=$(x64_client_ticks)
+    busy=
+    x64_bootstrap_active && busy=1
+    if [ "$last" -ge 0 ]; then
+      pct=$(( (ticks - last) * 100 / (tick * hz) ))
+      if [ "$pct" -lt 3 ] && [ -z "$busy" ]; then idle=$((idle + tick)); else idle=0; fi
+    fi
+    last=$ticks
+    avail=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo 2>/dev/null)
+    if [ "$idle" -ge "$stall" ] && [ "$elapsed" -ge "$least" ]; then
+      if [ "$mode" = gpu ]; then
+        printf '%s\n%s\n' "$(x64_client_build)" "the client stopped doing anything on the GPU renderer on $(date -u +%F)" > "$soft_file"
+        : > "$REAL_HOME/.bl-restart-software"
+        step "steam has done nothing for $idle s and shows no image: restarting Steam with software rendering"
+        x64_stop_client "$client"
+        return 0
+      fi
+      step "steam has done nothing for $idle s and shows no image${lib:+ (missing library $lib)}: share the logs from the menu"
+      idle=0
+      said=$elapsed
+    elif [ $((elapsed - said)) -ge "$every" ]; then
+      said=$elapsed
+      step "steam is still starting: $elapsed s, client cpu $pct%${avail:+, $avail MB free}${busy:+, updating or verifying}${lib:+, missing library $lib}"
+    fi
+  done
+}
+
 x64_exec() {
+  local soft_file=$X64_HOME/.droiddeck-cef-software build watch=report
+  build=$(x64_client_build)
+  if [ -f "$soft_file" ]; then
+    if [ -n "$build" ] && [ "$(head -n1 "$soft_file")" = "$build" ]; then
+      export BL_X64_CEF_GPU=0
+      step "steam's menus use software rendering on this device: $(sed -n 2p "$soft_file") (client $build)"
+    else
+      rm -f "$soft_file"
+      step "the Steam client is now build ${build:-?}: trying the GPU renderer for its menus again"
+    fi
+  fi
   x64_env
   cd "$STEAM_X64"
   if [ "${BL_X64_X86_WEBHELPER:-0}" != 1 ] && [ -x /usr/local/bin/droiddeck-x64-arm-webhelper ] &&
@@ -917,6 +1012,12 @@ x64_exec() {
