diff --git a/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt b/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt
new file mode 100644
index 0000000..9fec5c1
--- /dev/null
+++ b/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt
@@ -0,0 +1,45 @@
+package com.droiddeck.launcher.session
+
+import android.app.Application
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.robolectric.RuntimeEnvironment
+
+/** The steps droiddeck-steam-x64's first-frame watch writes are shown, in the app's language, instead of the
+ *  generic "Waiting for Steam's first frame". */
+@org.junit.runner.RunWith(org.robolectric.RobolectricTestRunner::class)
+@org.robolectric.annotation.Config(sdk = [33], application = Application::class)
+class LoadingStepExplainedTest {
+    private val res get() = RuntimeEnvironment.getApplication().resources
+
+    @Test fun aBusyClientShowsTimeCpuMemoryAndActivity() {
+        val text = LoadingState.explainedStep(res, "steam is still starting: 125 s, client cpu 87%, 2310 MB free, updating or verifying")!!
+        assertTrue(text, text.startsWith("Steam is still starting · 2:05 · client CPU 87%"))
+        assertTrue(text, "2310 MB free" in text)
+        assertTrue(text, "updating or checking its files" in text)
+    }
+
+    @Test fun aMissingLibraryIsNamed() {
+        val text = LoadingState.explainedStep(res, "steam is still starting: 40 s, client cpu 0%, missing library libnss3.so")!!
+        assertTrue(text, "missing library libnss3.so" in text)
+    }
+
+    @Test fun recoveryAndFailureStepsAreExplained() {
+        assertEquals("Steam's menus failed on the GPU (3 errors): starting Steam again with software rendering",
+            LoadingState.explainedStep(res, "steam's menus failed on the GPU (3 GPU process exits): restarting Steam with software rendering"))
+        assertTrue(LoadingState.explainedStep(res, "steam has done nothing for 180 s and shows no image: restarting Steam with software rendering")!!
+            .contains("starting it again with software rendering"))
+        assertTrue(LoadingState.explainedStep(res, "steam has done nothing for 180 s and shows no image: share the logs from the menu")!!
+            .contains("share the logs"))
+        assertTrue(LoadingState.explainedStep(res, "steam's menus use software rendering on this device: the GPU renderer failed")!!
+            .contains("software rendering"))
+        assertTrue(LoadingState.explainedStep(res, "checking Proton for this CPU (ARMv8.0; the first time downloads 626 MB)")!!.contains("626 MB"))
+    }
+
+    @Test fun otherStepsKeepTheirText() {
+        assertNull(LoadingState.explainedStep(res, "starting the Steam client"))
+        assertNull(LoadingState.explainedStep(res, "x86-64 Steam client ready"))
+    }
+}
