                 context.getString(com.droiddeck.launcher.R.string.loadstate_steam_client, clientDownload), clientPercent,
                 Topic.STEAM, readable = true,
             )
-            stepText != null -> Line(stepText, -1, topicOf(stepText, steam), readableScriptStep(stepText))
+            stepText != null -> {
+                val explained = explainedStep(res, stepText)
+                Line(explained ?: stepText, -1, topicOf(stepText, steam), explained != null || readableScriptStep(stepText))
+            }
             else -> null
         }
     }
@@ -151,6 +154,32 @@ class LoadingState(context: Context, private val steam: Boolean = true) {
             return count.groupValues[1] to (part.toLong() * 100 / maxOf(1, all)).coerceIn(0L, 100L).toInt()
         }
 
+        /** The steps that explain a slow or failing Steam start (droiddeck-steam-x64's first-frame watch and the
+         *  ARMv8.0 preparation), in the app's language; null for any other step. */
+        internal fun explainedStep(res: android.content.res.Resources, scriptStep: String): String? {
+            BUSY.find(scriptStep)?.let { m ->
+                val seconds = m.groupValues[1].toInt()
+                val parts = mutableListOf(res.getString(com.droiddeck.launcher.R.string.loadstate_steam_busy, seconds / 60, seconds % 60, m.groupValues[2].toInt()))
+                m.groupValues[3].toIntOrNull()?.let { parts += res.getString(com.droiddeck.launcher.R.string.loadstate_free_memory, it) }
+                if (m.groupValues[4].isNotEmpty()) parts += res.getString(com.droiddeck.launcher.R.string.loadstate_steam_verifying)
+                if (m.groupValues[5].isNotEmpty()) parts += res.getString(com.droiddeck.launcher.R.string.loadstate_missing_library, m.groupValues[5])
+                return parts.joinToString(" · ")
+            }
+            GPU_FAILED.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_gpu_failed, it.groupValues[1].toInt()) }
+            STALLED_RESTART.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_stalled_restart, it.groupValues[1].toInt()) }
+            STALLED.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_stalled, it.groupValues[1].toInt()) }
+            if (scriptStep.startsWith("steam's menus use software rendering")) return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_software)
+            if (scriptStep.startsWith("the Steam client is now build")) return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_gpu_retry)
+            if (scriptStep.startsWith("checking Proton for this CPU")) return res.getString(com.droiddeck.launcher.R.string.loadstate_proton_armv80)
+            if (scriptStep.startsWith("checking the x86-64 Steam client")) return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_x64_check)
+            return null
+        }
+
+        private val BUSY = Regex("""^steam is still starting: (\d+) s, client cpu (\d+)%(?:, (\d+) MB free)?(, updating or verifying)?(?:, missing library (\S+))?""")
+        private val GPU_FAILED = Regex("""^steam's menus failed on the GPU \((\d+) GPU process exits\)""")
+        private val STALLED_RESTART = Regex("""^steam has done nothing for (\d+) s and shows no image: restarting""")
+        private val STALLED = Regex("""^steam has done nothing for (\d+) s and shows no image""")
+
         internal fun readableScriptStep(scriptStep: String): Boolean {
             val t = scriptStep.lowercase()
             return t.startsWith("download") || t.startsWith("checking the linux") || t.startsWith("unpacking") || t.startsWith("installing")
