diff --git a/tools/tests/test_steam_first_frame_watch.py b/tools/tests/test_steam_first_frame_watch.py
new file mode 100644
index 0000000..1016214
--- /dev/null
+++ b/tools/tests/test_steam_first_frame_watch.py
@@ -0,0 +1,112 @@
+"""droiddeck-steam-x64's first-frame watch: while the x86-64 client starts and nothing is on screen it explains
+what the client is doing, restarts it once with software rendering when its menu renderer gives up on the GPU or
+stops doing anything, remembers that per client build, and never restarts more than once per session."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+import unittest
+
+BIN = Path(__file__).resolve().parents[1] / 'linuxfs/overlay/usr/local/bin'
+X64 = (BIN / 'droiddeck-steam-x64').read_text()
+SESSION = (BIN / 'droiddeck-session').read_text()
+
+
+def between(text, start, end):
+    begin = text.index(start)
+    return text[begin:text.index(end, begin)]
+
+
+HELPERS = between(X64, 'x64_client_build() {', 'x64_exec() {')
+
+
+class FirstFrameWatchTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+        self.home = self.root / 'home'
+        self.x64 = self.home / '.droiddeck-x64'
+        self.steam = self.x64 / 'Steam'
+        (self.steam / 'logs').mkdir(parents=True)
+        (self.steam / 'package').mkdir()
+        (self.steam / 'package/beta').write_text('publicbeta\n')
+        (self.steam / 'package/steam_client_publicbeta_steamrt64.manifest').write_text('"ubuntu12"\n{\n\t"version"\t\t"1763000000"\n}\n')
+        self.console = self.steam / 'logs/console-linux.txt'
+        self.console.write_text('old line\n')
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def run_watch(self, mode, during='', seconds=20, env=None):
+        script = ('step() { echo "== STEP $*"; }\n' + HELPERS +
+                  'REAL_HOME=%s X64_HOME=%s STEAM_X64=%s X64_CHANNEL=publicbeta\n'
+                  'sleep 300 & client=$!\n'
+                  'x64_first_frame_watch "$client" %s &\nwatch=$!\n%s\n'
+                  'wait "$watch"; if kill -0 "$client" 2>/dev/null; then echo CLIENT-ALIVE; kill "$client"; else echo CLIENT-STOPPED; fi\n'
+                  % (self.home, self.x64, self.steam, mode, during))
+        environment = dict(os.environ, BL_X64_WATCH_TICK='1', BL_X64_WATCH_SAY='2', BL_X64_WATCH_STALL='3',
+                           BL_X64_WATCH_MIN='4', **(env or {}))
+        return subprocess.run(['bash', '-u', '-c', script], env=environment, capture_output=True, text=True,
+                              timeout=seconds + 40)
+
+    def test_gpu_renderer_giving_up_restarts_once_with_software_rendering(self):
+        result = self.run_watch('gpu', 'sleep 1; for i in 1 2; do echo "GPU process exited unexpectedly: exit_code=139" >> %s; done; '
+                                       'echo "GPU process isn\'t usable. Goodbye." >> %s' % (self.console, self.console))
+        self.assertIn('CLIENT-STOPPED', result.stdout)
+        self.assertIn("steam's menus failed on the GPU (2 GPU process exits): restarting Steam with software rendering", result.stdout)
+        soft = (self.x64 / '.droiddeck-cef-software').read_text().splitlines()
+        self.assertEqual(soft[0], '1763000000')
+        self.assertTrue((self.home / '.bl-restart-software').exists())
+
+    def test_gpu_errors_from_an_earlier_run_are_not_counted(self):
+        self.console.write_text("GPU process isn't usable. Goodbye.\n" * 3)
+        result = self.run_watch('gpu', 'sleep 3; : > %s/.bl-first-frame' % self.home)
+        self.assertIn('CLIENT-ALIVE', result.stdout)
+        self.assertFalse((self.x64 / '.droiddeck-cef-software').exists())
+
+    def test_the_first_frame_ends_the_watch_without_touching_the_client(self):
+        result = self.run_watch('gpu', 'sleep 2; : > %s/.bl-first-frame' % self.home)
+        self.assertIn('CLIENT-ALIVE', result.stdout)
+        self.assertNotIn('restarting', result.stdout)
+
+    def test_a_stalled_client_on_the_gpu_renderer_is_restarted_with_software_rendering(self):
+        result = self.run_watch('gpu')
+        self.assertIn('CLIENT-STOPPED', result.stdout)
+        self.assertIn('shows no image: restarting Steam with software rendering', result.stdout)
+        self.assertIn('stopped doing anything', (self.x64 / '.droiddeck-cef-software').read_text())
+
+    def test_a_stalled_client_in_software_mode_is_only_reported(self):
+        result = self.run_watch('software', 'sleep 7; : > %s/.bl-first-frame' % self.home)
+        self.assertIn('CLIENT-ALIVE', result.stdout)
+        self.assertIn('shows no image: share the logs from the menu', result.stdout)
+        self.assertFalse((self.home / '.bl-restart-software').exists())
+
+    def test_progress_is_reported_while_it_starts(self):
+        result = self.run_watch('software', 'sleep 3; : > %s/.bl-first-frame' % self.home)
+        self.assertRegex(result.stdout, r'steam is still starting: \d+ s, client cpu \d+%')
+
+    def test_a_missing_library_is_named(self):
+        result = self.run_watch('software', 'sleep 1; echo "steamwebhelper: error while loading shared libraries: libnss3.so: cannot open" >> %s; '
+                                            'sleep 3; : > %s/.bl-first-frame' % (self.console, self.home))
+        self.assertIn('missing library libnss3.so', result.stdout)
+
+
+class SessionLoopTest(unittest.TestCase):
+    def test_the_session_restarts_the_client_once_for_software_rendering(self):
+        block = between(SESSION, 'if [ -f "$HOME/.bl-restart-software" ]; then', 'if [ "$steam_x64" = 1 ] && [ "$rc" -eq 132 ]')
+        self.assertIn('_bl_x64_software=1', block)
+        self.assertIn('continue', block)
+        self.assertIn('if [ -z "${_bl_x64_software:-}" ]', block)
+
+    def test_markers_are_cleared_when_a_session_starts(self):
+        self.assertIn('rm -f "$HOME/.bl-first-frame" "$HOME/.bl-restart-software"', SESSION)
+
+    def test_a_new_client_build_tries_the_gpu_again(self):
+        block = between(X64, 'x64_exec() {', 'x64_env\n  cd "$STEAM_X64"')
+        self.assertIn('export BL_X64_CEF_GPU=0', block)
+        self.assertIn('rm -f "$soft_file"', block)
+
+
+if __name__ == '__main__':
+    unittest.main()
