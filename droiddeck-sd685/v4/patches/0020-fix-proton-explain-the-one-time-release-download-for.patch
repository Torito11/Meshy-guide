From f11c2c4383ef0abf4a11a097ec465305f4e88a5a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 16:49:43 +0000
Subject: [PATCH 20/21] fix(proton): explain the one-time release download for
 the ARMv8.0 build on the loading screen

The step droiddeck-proton-armv80 writes when the installed DroidDeck-Proton 11-12.8 has component-updated
files is shown in the app's language (en, es, es-419), with the file that was replaced.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../main/java/com/droiddeck/launcher/session/LoadingState.kt   | 2 ++
 app/src/main/res/values-b+es+419/strings.xml                   | 1 +
 app/src/main/res/values-es/strings.xml                         | 1 +
 app/src/main/res/values/strings.xml                            | 1 +
 .../com/droiddeck/launcher/session/LoadingStepExplainedTest.kt | 3 +++
 5 files changed, 8 insertions(+)

diff --git a/app/src/main/java/com/droiddeck/launcher/session/LoadingState.kt b/app/src/main/java/com/droiddeck/launcher/session/LoadingState.kt
index 67e1b08..746cae9 100644
--- a/app/src/main/java/com/droiddeck/launcher/session/LoadingState.kt
+++ b/app/src/main/java/com/droiddeck/launcher/session/LoadingState.kt
@@ -179,6 +179,7 @@ class LoadingState(context: Context, private val steam: Boolean = true) {
             WEBHELPER_LOOP.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_webhelper_loop, it.groupValues[1].toInt()) }
             if (scriptStep.startsWith("checking which OpenGL Steam's menus can use")) return res.getString(com.droiddeck.launcher.R.string.loadstate_gl_check)
             if (scriptStep.startsWith("not downloading the x86-64 Steam client again")) return res.getString(com.droiddeck.launcher.R.string.loadstate_no_redownload)
+            PROTON_BASE_CHANGED.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_proton_base_changed, it.groupValues[1]) }
             GPU_FAILED.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_gpu_failed, it.groupValues[1].toInt()) }
             STALLED_RESTART.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_stalled_restart, it.groupValues[1].toInt()) }
             STALLED.find(scriptStep)?.let { return res.getString(com.droiddeck.launcher.R.string.loadstate_steam_stalled, it.groupValues[1].toInt()) }
@@ -191,6 +192,7 @@ class LoadingState(context: Context, private val steam: Boolean = true) {
 
         private val BUSY = Regex("""^steam is still starting: (\d+) s, client cpu (\d+)%(?:, (\d+) MB free)?(, updating or verifying)?(?:, missing library ([^,\s]+))?(?:, web helper restarts (\d+), OpenGL (\w+))?""")
         private val GL_SOFTWARE_RESTART = Regex("""^steam's menus could not use OpenGL on the GPU \((\d+) refused, (\d+) web helper restarts\): restarting""")
+        private val PROTON_BASE_CHANGED = Regex("""^the installed DroidDeck-Proton \S+ has (\S+) replaced""")
         private val WEBHELPER_LOOP = Regex("""^steam's menus could not be shown: Steam restarted its web helper (\d+) times""")
         private val GPU_FAILED = Regex("""^steam's menus failed on the GPU \((\d+) GPU process exits\)""")
         private val STALLED_RESTART = Regex("""^steam has done nothing for (\d+) s and shows no image: restarting""")
