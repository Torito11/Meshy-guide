diff --git a/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt b/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt
index e77f0d2..cfc713f 100644
--- a/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt
+++ b/app/src/test/java/com/droiddeck/launcher/session/LoadingStepExplainedTest.kt
@@ -63,6 +63,9 @@ class LoadingStepExplainedTest {
         assertTrue(LoadingState.explainedStep(res,
             "not downloading the x86-64 Steam client again: it starts, but its menus could not get OpenGL (its files are not the cause)")!!
             .contains("not downloaded again"))
+        assertEquals("Your DroidDeck-Proton 11-12.8 has an updated d3d12.dll (component updates): downloading the original release once to build the ARMv8.0 version (626 MB)",
+            LoadingState.explainedStep(res, "the installed DroidDeck-Proton 11-12.8 has d3d12.dll replaced (by a component update): " +
+                "installing the ARMv8.0 version from the original release instead (626 MB download, once)"))
     }
 
     @Test fun otherStepsKeepTheirText() {
