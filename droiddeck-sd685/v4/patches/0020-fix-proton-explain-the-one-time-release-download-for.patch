--- a/app/src/main/res/values/strings.xml
+++ b/app/src/main/res/values/strings.xml
@@ -2225,6 +2225,7 @@
     <string name="loadstate_webhelper_loop">Steam\'s menus could not be shown: Steam restarted its web helper %1$d times. Steam was stopped instead of retrying for ever. Share the logs</string>
     <string name="loadstate_webhelper_restarts">web helper restarted %1$d times</string>
