diff --git a/tools/tests/test_armv80_install_base.py b/tools/tests/test_armv80_install_base.py
new file mode 100644
index 0000000..515a25f
--- /dev/null
+++ b/tools/tests/test_armv80_install_base.py
@@ -0,0 +1,136 @@
+"""droiddeck-proton-armv80 with an installed DroidDeck-Proton 11-12.8 that DroidDeck's component updates changed.
+
+A Snapdragon 685's log (DroidDeck-2026-11-21-01-steam.zip): the installed release was copied as the base, 2 GB in
+32 s, and then "files/lib/wine/vkd3d-proton/aarch64-windows/d3d12.dll is not the file the patch was made for", so
+the ARMv8.0 build was never installed and the same copy failed again at every start. Now a changed base is noticed
+before the copy (for what the component manager swaps) or after it (anything else), the verified release is used
+instead, and a changed base is not copied again."""
+import hashlib
+import os
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import tarfile
+import tempfile
+import unittest
+import zlib
+
+INSTALLER = Path(__file__).resolve().parents[1] / 'linuxfs/overlay/usr/local/bin/droiddeck-proton-armv80'
+RELEASE = 'DroidDeck-Proton 11-12.8'
+D3D12 = 'files/lib/wine/vkd3d-proton/aarch64-windows/d3d12.dll'
+KERNEL32 = 'files/lib/wine/aarch64-windows/kernel32.dll'
+ORIGINAL = {D3D12: b'MZ vkd3d-proton 2.14 d3d12 ' * 40, KERNEL32: b'MZ wine kernel32 ' * 60}
+PATCHED = {name: data[:8] + b'LLSC' + data[12:] for name, data in ORIGINAL.items()}
+VDF = '"compatibilitytools"\n{\n  "compat_tools"\n  {\n    "DroidDeck-Proton-11-12.8"\n    {\n      "install_path" "."\n' \
+      '      "display_name" "DroidDeck-Proton 11-12.8"\n      "from_oslist" "windows"\n      "to_oslist" "linux"\n    }\n  }\n}\n'
+
+RUN = r'''
+import runpy, sys
+g = runpy.run_path(sys.argv[1])["main"].__globals__
+g.update(URL=sys.argv[2], SHA256=sys.argv[3], PATCH=sys.argv[4], NEED_BYTES=0)
+sys.argv = ["droiddeck-proton-armv80", sys.argv[5]]
+g["main"]()
+'''
+
+
+def patch_file(path):
+    body = b''
+    for name in (D3D12, KERNEL32):
+        before, after = ORIGINAL[name], PATCHED[name]
+        body += struct.pack('<H', len(name)) + name.encode()
+        body += hashlib.sha256(before).digest() + hashlib.sha256(after).digest()
+        body += struct.pack('<QI', len(after), 1) + struct.pack('<QI', 8, 4) + b'LLSC'
+    path.write_bytes(b'LSE80PATCH1\n' + struct.pack('<I', 2) + zlib.compress(body))
+
+
+def release_tree(root, changes=None):
+    tree = root / RELEASE
+    for name, data in ORIGINAL.items():
+        (tree / name).parent.mkdir(parents=True, exist_ok=True)
+        (tree / name).write_bytes((changes or {}).get(name, data))
+    (tree / 'toolmanifest.vdf').write_text('"manifest"\n{\n  "commandline" "/proton %verb%"\n}\n')
+    (tree / 'compatibilitytool.vdf').write_text(VDF)
+    (tree / 'proton').write_text('#!/usr/bin/env python3\n')
+    return tree
+
+
+class InstallFromChangedBaseTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        root = Path(self.tmp.name)
+        self.steam = root / 'Steam'
+        self.tools = self.steam / 'compatibilitytools.d'
+        self.tools.mkdir(parents=True)
+        self.patch = root / 'proton.lse80'
+        patch_file(self.patch)
+        pristine = root / 'pristine'
+        pristine.mkdir()
+        release_tree(pristine)
+        self.tarball = root / 'DroidDeck-Proton-11-12.8-aarch64.tar.gz'
+        with tarfile.open(self.tarball, 'w:gz') as tar:
+            tar.add(pristine / RELEASE, arcname=RELEASE)
+        self.sha = hashlib.sha256(self.tarball.read_bytes()).hexdigest()
+        self.url = self.tarball.as_uri()
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def install(self, url=None):
+        return subprocess.run([sys.executable, '-c', RUN, str(INSTALLER), url or self.url, self.sha, str(self.patch),
+                               str(self.steam)], capture_output=True, text=True, timeout=120)
+
+    def installed(self):
+        tree = self.tools / 'ARMv8.0-DroidDeck-Proton-11-12.8'
+        self.assertTrue((tree / '.droiddeck-armv80').is_file())
+        for name, data in PATCHED.items():
+            self.assertEqual((tree / name).read_bytes(), data, name)
+        self.assertIn('droiddeck-proton-11-12.8-armv80', (tree / 'compatibilitytool.vdf').read_text())
+
+    def test_a_base_with_a_dll_a_component_update_replaced_is_not_copied(self):
+        base = release_tree(self.tools, {D3D12: b'MZ vkd3d-proton 2.15 nightly'})
+        result = self.install()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn('has d3d12.dll replaced (by a component update)', result.stdout)
+        self.assertNotIn('using the installed', result.stdout)
+        self.installed()
+        self.assertEqual((base / D3D12).read_bytes(), b'MZ vkd3d-proton 2.15 nightly')   # the user's tool is left alone
+        self.assertFalse((self.tools / '.droiddeck-armv80').exists())
+
+    def test_any_other_change_found_while_patching_falls_back_to_the_release_in_the_same_start(self):
+        release_tree(self.tools, {KERNEL32: b'MZ wine kernel32 rebuilt'})
+        result = self.install()
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn('using the installed', result.stdout)
+        self.assertIn('has kernel32.dll replaced', result.stdout)
+        self.installed()
+
+    def test_an_unchanged_base_is_used_without_downloading(self):
+        release_tree(self.tools)
+        result = self.install(url=(self.tarball.parent / 'missing.tar.gz').as_uri())
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn('using the installed', result.stdout)
+        self.installed()
+
+    def test_a_changed_base_is_not_copied_again_after_a_failed_download(self):
+        release_tree(self.tools, {KERNEL32: b'MZ wine kernel32 rebuilt'})
+        missing = (self.tarball.parent / 'missing.tar.gz').as_uri()
+        first = self.install(url=missing)
+        self.assertNotEqual(first.returncode, 0)
+        self.assertIn('download failed', first.stderr)
+        second = self.install(url=missing)
+        self.assertIn('was found changed before (files/lib/wine/aarch64-windows/kernel32.dll)', second.stdout)
+        self.assertNotIn('using the installed', second.stdout)
+        third = self.install()
+        self.assertEqual(third.returncode, 0, third.stdout + third.stderr)
+        self.installed()
+
+    def test_an_installed_armv80_build_is_reported_without_work(self):
+        release_tree(self.tools)
+        self.assertEqual(self.install().returncode, 0)
+        again = self.install(url=(self.tarball.parent / 'missing.tar.gz').as_uri())
+        self.assertEqual(again.stdout.strip(), 'droiddeck-proton-11-12.8-armv80')
+
+
+if __name__ == '__main__':
+    unittest.main()
