+class Mismatch(Exception):
+    """A file is not the release's own, so the patch cannot be applied to it."""
+
+
+# What DroidDeck's component manager swaps inside a DroidDeck-Proton tree it keeps up to date (DXVK, vkd3d-proton and
+# FEX's arm64ec/wow64 DLLs). A phone's log: the installed release was copied (2 GB, 32 s) and then
+# "files/lib/wine/vkd3d-proton/aarch64-windows/d3d12.dll is not the file the patch was made for", at every start.
+SWAPPED = frozenset(("d3d8.dll", "d3d9.dll", "d3d10core.dll", "d3d11.dll", "dxgi.dll", "d3d12.dll", "d3d12core.dll",
+                     "libarm64ecfex.dll", "libwow64fex.dll"))
+
+
+def changed_file(tree, entries, only=None):
+    """The first file the patch rewrites that is not the release's own (or is missing), else None."""
+    for name, before, _after, _size, _runs in entries:
+        if only is not None and os.path.basename(name) not in only:
+            continue
+        try:
+            if bytes.fromhex(sha256_file(os.path.join(tree, name))) != before:
+                return name
+        except OSError:
+            return name
+    return None
+
+
 def apply(tree, entries):
     for name, before, after, size, runs in entries:
         path = os.path.join(tree, name)
         data = bytearray(open(path, "rb").read())
         if hashlib.sha256(data).digest() != before:
-            raise SystemExit("droiddeck-proton-armv80: %s is not the file the patch was made for" % name)
+            raise Mismatch(name)
         if len(data) < size:
             data += b"\0" * (size - len(data))
         del data[size:]
