+def note_changed(note, name):
+    """Remembered until the install succeeds, so a changed base is not copied again at every start."""
+    step("the installed %s has %s replaced (by a component update): installing the ARMv8.0 version from the original "
+         "release instead (626 MB download, once)" % (RELEASE, os.path.basename(name)))
+    with open(note, "w") as f:
+        f.write(name + "\n")
+
+
+def unpack_release(staging, tree):
+    """The pinned upstream release, downloaded (resuming), checked and unpacked to `tree`."""
+    tarball = os.path.join(staging, "DroidDeck-Proton-11-12.8-aarch64.tar.gz")
+    if not (os.path.isfile(tarball) and sha256_file(tarball) == SHA256):
+        log("downloading %s (626 MB, once; a partial download resumes)" % RELEASE)
+        rc = download(URL, tarball)
+        if rc != 0:
+            raise SystemExit("droiddeck-proton-armv80: download failed (curl %d)" % rc)
+        if sha256_file(tarball) != SHA256:
+            os.unlink(tarball)
+            raise SystemExit("droiddeck-proton-armv80: the download did not match its checksum")
+    step("unpacking DroidDeck-Proton 11-12.8 (a few minutes)")
+    unpacked = os.path.join(staging, "unpacked")
+    shutil.rmtree(unpacked, ignore_errors=True)
+    os.makedirs(unpacked)
+    if subprocess.call(["tar", "-xf", tarball, "-C", unpacked]) != 0:
+        raise SystemExit("droiddeck-proton-armv80: tar failed")
+    os.rename(os.path.join(unpacked, RELEASE), tree)
+    shutil.rmtree(unpacked, ignore_errors=True)
+    os.unlink(tarball)
+
+
 def main():
