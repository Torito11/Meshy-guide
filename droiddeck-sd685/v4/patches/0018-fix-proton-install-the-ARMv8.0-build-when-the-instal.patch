+package com.droiddeck.launcher.session
+
+import android.content.Context
+import com.droiddeck.launcher.runtime.LinuxRuntime
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import java.io.File
+
+/** The ARMv8.0 build of DroidDeck-Proton (droiddeck-proton-armv80) is never offered for component swaps or kept up to
+ *  date: its DLLs were rewritten for CPUs without LSE atomics, and a swapped-in DXVK, vkd3d-proton or FEX build would
+ *  bring them back. The release it is made from, which the component updates do change, stays listed. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE)
+class Armv80ProtonComponentsTest {
+    @Test fun theArmv80BuildIsNotListedForComponents() {
+        val context: Context = RuntimeEnvironment.getApplication()
+        val root = LinuxRuntime.rootDir(context)
+        root.deleteRecursively()
+        val tools = File(root, "root/.local/share/Steam/compatibilitytools.d")
+        for (name in listOf("DroidDeck-Proton 11-12.8", "ARMv8.0-DroidDeck-Proton-11-12.8")) {
+            File(tools, "$name/files/lib/wine").mkdirs()
+            File(tools, "$name/proton").writeText("# test Proton\n")
+        }
+        File(tools, "ARMv8.0-DroidDeck-Proton-11-12.8/.droiddeck-armv80").writeText("patch sha256\n")
+
+        assertEquals(listOf("DroidDeck-Proton 11-12.8"), ComponentsManager.protons(context).map { it.dir.name })
+    }
+}
