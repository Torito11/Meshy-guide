From 9caeffe8200cdec1bbea3b58e31352b4386c634d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 21 Nov 2026 16:43:29 +0000
Subject: [PATCH 19/21] chore(diagnostics): keep Steam's log names readable and
 add the OpenGL decision

The shared logs ZIP named Steam's webhelper.txt, steamui_html.txt, console-linux.txt and DroidDeck's own
start-up extras entry-<hash>, which made a stuck Steam start hard to follow. These fixed names say nothing
about the user and are now kept. The x86-64 launcher's OpenGL decision (.droiddeck-gl-mode) is included.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../com/droiddeck/launcher/session/DiagnosticsExtras.kt     | 5 +++--
 .../droiddeck/launcher/session/EnhancedSessionLogShare.kt   | 6 ++++++
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt b/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt
index 3cbcd5d..7892322 100644
--- a/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt
+++ b/app/src/main/java/com/droiddeck/launcher/session/DiagnosticsExtras.kt
@@ -12,7 +12,8 @@ import java.io.RandomAccessFile
 /**
  * Files the shared logs ZIP gets in addition to the session folder, written just before it is packed (the ZIP's own
  * redaction then applies to them like to every other file): start-up times (also for a start that never reached the
- * screen), memory and thermal state, and the x86-64 client launcher's own log with its renderer choice.
+ * screen), memory and thermal state, and the x86-64 client launcher's own log with its renderer choices (the
+ * OpenGL its windows use, checked on the device, and its menus' software rendering).
  */
 object DiagnosticsExtras {
     private const val TAIL = 2L * 1024 * 1024
@@ -24,7 +25,7 @@ object DiagnosticsExtras {
             val home = File(LinuxRuntime.rootDir(context), "root/.droiddeck-x64")
             val out = File(dir, "steam-x64").apply { mkdirs() }
             tail(File(home, "steam-x64.log"), File(out, "steam-x64.log"))
-            for (name in listOf(".droiddeck-cef-software", ".droiddeck-client-ok")) {
+            for (name in listOf(".droiddeck-cef-software", ".droiddeck-client-ok", ".droiddeck-gl-mode")) {
                 File(home, name).takeIf { it.isFile }?.copyTo(File(out, name.trimStart('.') + ".txt"), overwrite = true)
             }
             if (out.list().isNullOrEmpty()) out.delete()
diff --git a/app/src/main/java/com/droiddeck/launcher/session/EnhancedSessionLogShare.kt b/app/src/main/java/com/droiddeck/launcher/session/EnhancedSessionLogShare.kt
index 6f9f364..2a2b106 100644
--- a/app/src/main/java/com/droiddeck/launcher/session/EnhancedSessionLogShare.kt
+++ b/app/src/main/java/com/droiddeck/launcher/session/EnhancedSessionLogShare.kt
@@ -950,6 +950,12 @@ internal object EnhancedSessionLogShare {
         "frame-trace.log", "process-trace.log", "game-lifecycle.log", "launches.log", "tools.tsv", "wanted.tsv", "prefixes.json",
         "battlenet.log", "spawned.log", "flatpak-install.log", "cef_log.txt", "cef_log.previous.txt",
         "console_log.txt", "webhelper_js.txt", "controller_support.txt", "systemperfmanager.txt",
+        // Steam's own log names and DroidDeck's start-up extras (DiagnosticsExtras, droiddeck-steam-x64): fixed names
+        // that say nothing about the user, kept readable so a stuck Steam start can be followed in the ZIP.
+        "webhelper.txt", "webhelper_gpu.txt", "steamui_html.txt", "console-linux.txt", "bootstrap_log.txt",
+        "transport_client.txt", "transport_steamui.txt", "connection_log.txt", "steamui_system.txt", "compat_log.txt",
+        "shader_log.txt", "content_log.txt", "timings.txt", "memory.txt", "limits.txt", "steam-x64", "steam-x64.log",
+        "droiddeck-cef-software.txt", "droiddeck-client-ok.txt", "droiddeck-gl-mode.txt", "x64-gl-probe.txt",
     )
     private val KNOWN_COMPONENT_PATTERNS = listOf(
         Regex("[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{2,}-[a-z0-9-]{1,24}"),
-- 
2.43.0

