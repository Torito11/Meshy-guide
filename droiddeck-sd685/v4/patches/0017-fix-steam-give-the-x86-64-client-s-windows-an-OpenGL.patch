index 3282610..f231b23 100755
--- a/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
+++ b/tools/linuxfs/overlay/usr/local/bin/droiddeck-steam-x64
@@ -460,11 +460,17 @@ x64_repair=
 if [ "${BL_X64_REPAIR:-0}" = 1 ]; then
   x64_repair=requested
 elif [ -f "$unconfirmed" ] && ! grep -qx repaired "$unconfirmed" && [ "$(grep -cx start "$unconfirmed")" -ge 2 ]; then
-  x64_repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
+  # The first-frame watch writes "cause opengl" when Steam's own logs showed its menus could not get OpenGL: the
+  # client's files are fine then, and downloading them again (about 700 MB) would change nothing.
+  if grep -qx 'cause opengl' "$unconfirmed"; then
+    step "not downloading the x86-64 Steam client again: it starts, but its menus could not get OpenGL (its files are not the cause)"
+  else
+    x64_repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
+  fi
 fi
 if [ -n "$x64_repair" ]; then
   step "repairing the x86-64 Steam client ($x64_repair)"
-  rm -f "$X64_HOME/.droiddeck-client-ok" "$X64_HOME/.droiddeck-cef-software"
+  rm -f "$X64_HOME/.droiddeck-client-ok" "$X64_HOME/.droiddeck-cef-software" "$X64_HOME/.droiddeck-gl-mode"
   rm -f "$STEAM_X64/package/droiddeck-installed" "$STEAM_X64/.crash" "$STEAM_X64/steam.pid" \
     "$STEAM_X64"/package/steam_client_*.installed
 fi
@@ -935,12 +941,93 @@ x64_stop_client() {
 # rendering, remembered for this client build. A client that has stopped doing anything is restarted once the same
 # way when it was on the GPU renderer, and only reported otherwise. The software choice persists, so nothing here
 # can restart the client more than once per session.
+# Lines matching $3 in log $1 from line $2 on (0 when there are none; never a failing status). A log that Steam
+# rotated or emptied since (now shorter than that) is read from its start.
+x64_since() {
+  local from=$2
+  [ "$(wc -l 2>/dev/null < "$1" || echo 0)" -lt $((from - 1)) ] && from=1
+  tail -n +"$from" "$1" 2>/dev/null | grep -c -- "$3" || true
+}
+
+# A real OpenGL context through FEX, made the way the client makes one: glxinfo -B makes a context current on the
+# session's X display and prints its renderer. $1 = gpu (FEX's GL/Vulkan thunks into the phone's driver) or software
+# (the x86 rootfs's own Mesa, llvmpipe). Prints what it saw; status 0 only when a context was made.
+x64_gl_try() {
+  local fex=${BL_FEX:-/usr/local/bin/FEX} out rc=0
+  [ -x "$ROOTFS/usr/bin/glxinfo" ] || { echo "no x86 glxinfo in the rootfs: cannot check"; return 2; }
+  [ -n "${DISPLAY:-}" ] || { echo "no X display yet: cannot check"; return 2; }
+  out=$(
+    unset LD_LIBRARY_PATH LD_PRELOAD
+    export FEX_ROOTFS=$ROOTFS
+    if [ "$1" = gpu ]; then
+      printf '{"ThunksDB": {"GL": 1, "Vulkan": 1}}\n' > "$X64_HOME/thunks.json"
+      export FEX_THUNKCONFIG=$X64_HOME/thunks.json
+      unset LIBGL_ALWAYS_SOFTWARE LIBGL_DRI3_DISABLE
+    else
+      unset FEX_THUNKCONFIG GALLIUM_DRIVER MESA_LOADER_DRIVER_OVERRIDE VK_ICD_FILENAMES VK_DRIVER_FILES LIBGL_KOPPER_DRI2 \
+        ZINK_DEBUG ZINK_DESCRIPTORS TU_DEBUG MESA_NO_ERROR mesa_glthread
+      export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe LIBGL_DRI3_DISABLE=1
+    fi
+    timeout "${BL_X64_GL_PROBE_TIMEOUT:-90}" "$fex" /usr/bin/glxinfo -B 2>&1
+  ) || rc=$?
+  printf '%s\n' "$out" | grep -E "OpenGL renderer string|OpenGL core profile version|direct rendering|rror|failed|unable" | head -8
+  [ "$rc" = 0 ] && printf '%s\n' "$out" | grep -q "OpenGL renderer string"
+}
+
+# The OpenGL the client's windows use, kept per FEX build, x86 rootfs and display driver ($X64_GL_KEY):
+# gpu, software, or none when neither made a context. Line 3 says why.
+x64_gl_record() {
+  printf '%s\n%s\n%s\n%s\n' "${X64_GL_KEY:-?}" "$1" "$2" "$(date -u +%F)" > "$X64_HOME/.droiddeck-gl-mode.tmp" &&
+    mv -f "$X64_HOME/.droiddeck-gl-mode.tmp" "$X64_HOME/.droiddeck-gl-mode"
+}
+
+# Steam draws its menus with its own composer inside steamwebhelper, which needs an OpenGL context: without one it
+# falls back, and the client restarts the helper about every 45 s for ever (a Snapdragon 685's logs: "failed to acquire
+# a gl context" and "Restart webhelper process" 23 times, FEX's thunked GL failing with "failed to create dri3 screen").
+# So before the client starts on a device where this was not checked yet, both ways are tried for real; only the one
+# that made a context is used. Prints the mode; its steps go to stderr.
+x64_gl_mode() {
+  local file=$X64_HOME/.droiddeck-gl-mode mode why gpu_out soft_out
+  if [ "$(head -n1 "$file" 2>/dev/null)" = "${X64_GL_KEY:-?}" ]; then sed -n 2p "$file"; return 0; fi
+  step "checking which OpenGL Steam's menus can use on this device (once, and after a driver or FEX change)" >&2
+  if ! x64_gpu || [ "${BL_X64_CLIENT_SOFTWARE:-0}" = 1 ]; then
+    if soft_out=$(x64_gl_try software); then mode=software why="no GPU thunks here; software: ${soft_out//$'\n'/; }"
+    else mode=none why="no GPU thunks here; software failed: ${soft_out//$'\n'/; }"; fi
+  elif gpu_out=$(x64_gl_try gpu); then
+    mode=gpu why="GPU through FEX's thunks: ${gpu_out//$'\n'/; }"
+  elif [ $? = 2 ]; then
+    mode=gpu why="not checked (${gpu_out//$'\n'/; }); the first-frame watch decides"
+  elif soft_out=$(x64_gl_try software); then
+    mode=software why="GPU through FEX's thunks failed (${gpu_out//$'\n'/; }); software: ${soft_out//$'\n'/; }"
+  else
+    mode=none why="GPU failed (${gpu_out//$'\n'/; }); software failed (${soft_out//$'\n'/; })"
+  fi
+  echo "== x86-64 OpenGL for Steam's menus: $mode ($why)" >&2
+  [ -n "${BL_DEBUG_DIR:-}" ] && printf '%s: %s\n%s\n' "$(date -u +%FT%T)" "$mode" "$why" >> "$BL_DEBUG_DIR/x64-gl-probe.txt" 2>/dev/null
+  [ "$mode" = gpu ] && [ "${why#not checked}" != "$why" ] || x64_gl_record "$mode" "$why"
+  echo "$mode"
+}
+
+# Until the app reports the first frame on screen ($REAL_HOME/.bl-first-frame), say what the client is doing and
+# recover from what can be recognised. It runs beside the client under the launcher's set -eu, so it turns -e off:
+# one failing test (a grep finding nothing) must not end it, as it silently did in 0.7.1-sd685.3.
+#   $2 = the OpenGL the client uses (gpu / software / none).
+# - Steam's composer could not get OpenGL on the GPU path, Chromium gave up on the GPU, or Steam keeps restarting its
+#   helper: software OpenGL, once per session, and only when a software context really works here.
+# - Steam restarted its helper BL_X64_WATCH_RESTARTS (4) times anyway: the client is stopped, with what was seen, rather
+#   than looping for ever.
